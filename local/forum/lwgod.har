[
  {
    "comment": "梦幻天堂·龙网（www.lwgod.org，Discuz X3）每日登录奖励。\n\n【认证方式】Cookie 登录态，不需要账号密码。变量 cookie 与 user_agent 由任务环境提供：\n  ① 推荐：在浏览器登录 www.lwgod.org 后，用「QianDao Cookie Extractor」一键读取整站 Cookie（HttpOnly 的登录 Cookie 一样能读到），连同 User-Agent 一起填入任务环境；\n  ② 手动：开发者工具 → 网络 → 任意一个请求 → 复制请求头里的 Cookie 整行，原样粘贴，不要解码或裁剪。\n\n【本模板做什么】只读访问，不执行任务、不发帖、不改账号设置：\n  1. 打开论坛首页，触发「每天登录」奖励；\n  2. 读取龙币 / 龙力 / 积分摘要；\n  3. 读取积分规则明细，确认「每天登录」这一条以及今天是否已发放，并取最近一次奖励时间；\n  4. 把以上信息写进任务日志。\n\n【登录态会过期】站点 Cookie 通常几周后失效。任务若提示「登录会话已失效，需要重新登录」，重新导出一次 Cookie 即可，模板本身不需要修改。\n\n【为什么带 X-QD-Impersonate】该站点对非浏览器指纹较敏感，此头让 QianDao 以 Chrome 的 TLS/HTTP2 指纹发起请求（仅 HTTPS，由应用校验）。",
    "request": {
      "method": "GET",
      "url": "https://www.lwgod.org/forum.php",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=[A-Za-z0-9]+",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|name=[\"']username[\"']|id=[\"']lsform[\"']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "uid",
          "re": "space-uid-([1-9]\\d*)\\.html",
          "from": "content"
        },
        {
          "name": "username",
          "re": "/class=[\"']vwmy[\"'][^>]*>.*?<a[^>]*>([^<]+)<\\/a>/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "读取龙币、龙力与积分摘要",
    "request": {
      "method": "GET",
      "url": "https://www.lwgod.org/home.php?mod=spacecp&ac=credit&showcredit=1",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://www.lwgod.org/forum.php"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=[A-Za-z0-9]+",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|name=[\"']username[\"']|id=[\"']lsform[\"']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "dragon_coin",
          "re": "/<em>\\s*龙币:\\s*<\\/em>\\s*([^<&\\r\\n]+)/s",
          "from": "content"
        },
        {
          "name": "dragon_power",
          "re": "/<em>\\s*龙力:\\s*<\\/em>\\s*([^<&\\r\\n]+)/s",
          "from": "content"
        },
        {
          "name": "points",
          "re": "/<em>\\s*积分:\\s*<\\/em>\\s*([^<&\\r\\n]+)/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "核对「每天登录」奖励记录与最近发放时间",
    "request": {
      "method": "GET",
      "url": "https://www.lwgod.org/home.php?mod=spacecp&ac=credit&op=log&suboperation=creditrulelog",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://www.lwgod.org/home.php?mod=spacecp&ac=credit&showcredit=1"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "rid=15[^>]*>每天登录<\\/a>",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|name=[\"']username[\"']|id=[\"']lsform[\"']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "daily_coin",
          "re": "/rid=15[^>]*>每天登录<\\/a>\\s*<\\/td>\\s*<td>\\s*\\d+\\s*<\\/td>\\s*<td>\\s*\\d+\\s*<\\/td>\\s*<td>\\s*(-?\\d+)\\s*<\\/td>/s",
          "from": "content"
        },
        {
          "name": "daily_power",
          "re": "/rid=15[^>]*>每天登录<\\/a>\\s*<\\/td>\\s*<td>\\s*\\d+\\s*<\\/td>\\s*<td>\\s*\\d+\\s*<\\/td>\\s*<td>\\s*-?\\d+\\s*<\\/td>\\s*<td>\\s*(-?\\d+)\\s*<\\/td>/s",
          "from": "content"
        },
        {
          "name": "last_reward",
          "re": "/rid=15[^>]*>每天登录<\\/a>.*?(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2})/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成任务日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "content=梦幻天堂·龙网每日登录奖励成功，账号: {{username|default('未知')|urlencode}}，UID: {{uid|default('未知')|urlencode}}，龙币: {{dragon_coin|default('未知')|urlencode}}，龙力: {{dragon_power|default('未知')|urlencode}}，积分: {{points|default('未知')|urlencode}}，每日奖励: 龙币+{{daily_coin|default('未知')|urlencode}}、龙力+{{daily_power|default('未知')|urlencode}}，最近奖励时间: {{last_reward|default('未知')|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
