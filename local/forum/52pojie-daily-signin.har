  {
    "comment": "读取吾爱币余额作为签到结果",
    "request": {
      "method": "GET",
      "url": "https://www.52pojie.cn/home.php?mod=spacecp&ac=credit&showcredit=1&inajax=1&ajaxtarget=extcreditmenu_menu",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Referer",
          "value": "https://www.52pojie.cn/forum.php"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "id=[\"']hcredit_2[\"'][^>]*>([^<]+)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "WZWS|challenge|您需要先登录|请先登录|name=[\"']username[\"']|id=[\"']lsform[\"']|安全验证|人机验证|滑块验证|验证码|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "log_value",
          "re": "id=[\"']hcredit_2[\"'][^>]*>([^<]+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出签到结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=吾爱币：{{log_value|default('未知')|urlencode}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
