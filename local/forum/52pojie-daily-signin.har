[
  {
    "comment": "读取吾爱破解首页并确认登录态，WZWS 或登录挑战直接失败关闭",
    "request": {
      "method": "GET",
      "url": "https://www.52pojie.cn/forum.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "href=[\"']space-uid-[1-9]\\d*\\.html[\"'][^>]*\\bid=[\"']m[\"']|action=logout",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "WZWS|challenge|您需要先登录|请先登录|name=[\"']username[\"']|id=[\"']lsform[\"']|安全验证|人机验证|滑块验证|验证码|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "领取每日签到任务",
    "request": {
      "method": "GET",
      "url": "https://www.52pojie.cn/home.php?mod=task&do=apply&id=2&referer=%2Fforum.php",
