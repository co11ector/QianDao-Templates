[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 www.chiphell.com 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】只读访问论坛首页和积分摘要页，触发站点“每日登录”记录；读取 UID、用户名、积分和邪恶指数写入日志。不会发帖、回复、领取其他奖励或修改账号设置。\n\n【成功判定】首页和积分页都必须保持同一账号登录，页面包含带 formhash 的退出登录链接，并能读到积分摘要。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 www.chiphell.com 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】站点对非浏览器网络指纹较敏感，模板固定使用 Chrome TLS/HTTP2 指纹；应用仍执行严格 HTTPS 证书与主机名校验。",
    "request": {
      "method": "GET",
      "url": "https://www.chiphell.com/forum.php",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "action=logout(?:&amp;|&)formhash=[A-Za-z0-9]+",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|登录后进行",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "uid",
          "re": "(?:home\\.php\\?mod=space(?:&amp;|&)uid=|space-uid-)([1-9]\\d*)",
          "from": "content"
        },
        {
          "name": "username",
          "re": "/class=[\"']vwmy[\"'][^>]*>.*?<a[^>]*>([^<]+)</s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "读取账户积分摘要",
    "request": {
      "method": "GET",
      "url": "https://www.chiphell.com/home.php?mod=spacecp&ac=credit&showcredit=1",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://www.chiphell.com/forum.php"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "action=logout(?:&amp;|&)formhash=[A-Za-z0-9]+",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|登录后进行",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "points",
          "re": "/积分:</em>\\s*([^<\\r\\n]+)/s",
          "from": "content"
        },
        {
          "name": "evil_points",
          "re": "/邪恶指数:</em>\\s*([^<\\r\\n]+)/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成执行日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "content=Chiphell每日登录访问成功，账号: {{username|default('未知')|urlencode}}，UID: {{uid|default('未知')|urlencode}}，积分: {{points|default('未知')|urlencode}}，邪恶指数: {{evil_points|default('未知')|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
