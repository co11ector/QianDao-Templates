[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 bbs.acgrip.com 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】只访问固定 DSU 签到页并提交一次签到：读取动态 formhash 后，以 qdxq=kx、qdmode=3、空留言提交；随后重新打开签到页核对本人今日签到时间。不会发帖、回复或修改资料。\n\n【成功判定】提交回执为 200，复核页仍显示同一登录账号，并出现“您今天已经签到过了或者签到时间还未开始”且上次签到日期就是今天。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 bbs.acgrip.com 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。",
    "request": {
      "method": "GET",
      "url": "https://bbs.acgrip.com/dsu_paulsign-sign.html",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "href=[\"\\']space-uid-[1-9]\\d*\\.html[\"\\'][^>]*\\bid=[\"\\']m[\"\\']",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|name=[\"\\']username[\"\\']|id=[\"\\']lsform[\"\\']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=[\"\\']formhash[\"\\']\\s+value=[\"\\']([a-fA-F0-9]{8})[\"\\']",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交每日签到，不填写留言",
    "request": {
      "method": "POST",
      "url": "https://bbs.acgrip.com/plugin.php?id=dsu_paulsign:sign&operation=qiandao&infloat=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://bbs.acgrip.com/dsu_paulsign-sign.html"
        },
        {
          "name": "Origin",
          "value": "https://bbs.acgrip.com"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&qdxq=kx&qdmode=3&todaysay=&fastreply=0",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^200$",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|name=[\"\\']username[\"\\']|id=[\"\\']lsform[\"\\']",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "读取当前账号状态",
    "request": {
      "method": "GET",
      "url": "https://bbs.acgrip.com/dsu_paulsign-sign.html",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?=[\\s\\S]*href=[\"\\']space-uid-[1-9]\\d*\\.html[\"\\'][^>]*\\bid=[\"\\']m[\"\\'])[\\s\\S]*?class=[\"\\']mn[\"\\'][^>]*>\\s*<h1[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h1|</div>)[\\s\\S])*?您上次签到时间:\\s*<font[^>]*>({{1|date_time(0)}} \\d{2}:\\d{2})</font>",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|name=[\"\\']username[\"\\']|id=[\"\\']lsform[\"\\']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "class=[\"\\']mn[\"\\'][^>]*>\\s*<h1[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h1|</div>)[\\s\\S])*?您上次签到时间:\\s*<font[^>]*>(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2})</font>",
          "from": "content"
        }
      ]
    }
  }
]
