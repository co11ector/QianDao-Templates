[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 bbs.3dmgame.com 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】只访问论坛首页和积分规则页，不进入任务大厅、不发帖、不改账号设置：\n1. 打开论坛首页触发“每天登录”奖励并读取当前积分；\n2. 若站点返回同域 yxd_token 会话引导，只补这一次临时 Cookie 后重新打开首页，不在任务环境中保存该令牌；\n3. 打开积分规则记录，读取“每天登录”的奖励值和最近发放时间；\n4. 把账号积分、奖励与时间写入任务日志。\n\n【成功判定】首页必须表现为已登录，积分规则页必须存在“每天登录”记录，并能在同一次运行中读到积分或最近奖励时间；仅有 HTTP 200 不算成功。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 bbs.3dmgame.com 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。",
    "request": {
      "method": "GET",
      "url": "https://bbs.3dmgame.com/forum.php",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?s)(?:member\\.php\\?mod=logging(?:&amp;|&)action=logout|document\\.cookie.*?location\\.href.*?/forum\\.php)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login",
          "from": "content"
        },
        {
          "re": "name=[\"\\x27]username[\"\\x27]",
          "from": "content"
        },
        {
          "re": "您需要先登录才能继续本操作",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "bootstrap_token",
          "re": "/document\\.cookie\\s*=\\s*[\"\\x27]yxd_token=([^;\"\\x27]+).*?[\"\\x27]/s",
          "from": "content"
        },
        {
          "name": "bootstrap_required",
          "re": "/(document)\\.cookie\\s*=\\s*[\"\\x27]yxd_token=[^;\"\\x27]+.*?[\"\\x27]/s",
          "from": "content"
        },
        {
          "name": "points",
          "re": "/积分:\\s*(\\d+)/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "仅在站点返回同域会话引导时继续",
    "request": {
      "method": "GET",
      "url": "{% if bootstrap_required == \"document\" %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "应用站点同域会话引导后验证登录态",
    "request": {
      "method": "GET",
      "url": "https://bbs.3dmgame.com/forum.php",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [
        {
          "name": "yxd_token",
          "value": "{{bootstrap_token}}"
        }
      ],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=logout",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login",
          "from": "content"
        },
        {
          "re": "name=[\"\\x27]username[\"\\x27]",
          "from": "content"
        },
        {
          "re": "您需要先登录才能继续本操作",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "points",
          "re": "/积分:\\s*(\\d+)/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "同域会话引导条件结束",
    "request": {
      "method": "GET",
      "url": "{% endif %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "读取每天登录奖励状态",
    "request": {
      "method": "GET",
      "url": "https://bbs.3dmgame.com/home.php?mod=spacecp&ac=credit&op=log&suboperation=creditrulelog",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://bbs.3dmgame.com/forum.php"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "每天登录",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login",
          "from": "content"
        },
        {
          "re": "name=[\"\\x27]username[\"\\x27]",
          "from": "content"
        },
        {
          "re": "您需要先登录才能继续本操作",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "login_reward",
          "re": "/每天登录.*?<td[^>]*>\\s*\\d+\\s*</td>.*?<td[^>]*>\\s*\\d+\\s*</td>.*?<td[^>]*>\\s*-?\\d+\\s*</td>.*?<td[^>]*>\\s*(-?\\d+)\\s*</td>/s",
          "from": "content"
        },
        {
          "name": "last_reward",
          "re": "/每天登录.*?(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2})/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成执行日志",
    "request": {
      "method": "GET",
      "url": "api://util/unicode?content=3DM%E6%AF%8F%E6%97%A5%E7%99%BB%E5%BD%95%E5%A5%96%E5%8A%B1%EF%BC%9A%E5%BD%93%E5%89%8D%E7%A7%AF%E5%88%86%20{{points|default('未知')|urlencode}}%EF%BC%8C%E6%AF%8F%E6%97%A5%E5%A5%96%E5%8A%B1%20{{login_reward|default('5')|urlencode}}%20%E9%87%91%E5%85%83%EF%BC%8C%E6%9C%80%E5%90%8E%E5%A5%96%E5%8A%B1%E6%97%B6%E9%97%B4%20{{last_reward|default('未知')|urlencode}}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
