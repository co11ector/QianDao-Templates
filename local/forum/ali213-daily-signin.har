      "method": "GET",
      "url": "{% if all([needs_reply, account_uid, formhash]) %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
