[
  {
    "comment": "只读打开固定签到主题，确认当前账号已登录、回复表单存在，并提取动态 formhash。",
    "request": {
      "method": "GET",
      "url": "https://game.ali213.net/thread-7098234-1-1.html",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/id=[\"']fastpostform[\"']/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "/<title[^>]*>\\s*(?:Just a moment\\.\\.\\.|Attention Required|安全验证)[^<]*<\\/title>|<form[^>]+id=[\"']lsform[\"']|<div[^>]+id=[\"']challenge-form[\"']|您需要先登录|请先登录|您需要登录后|登录后.{0,20}(?:回复|发帖)|您没有权限|禁止匿名发帖/i",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "account_uid",
          "re": "discuz_uid\\s*=\\s*[\"']([1-9]\\d*)[\"']",
          "from": "content"
        },
        {
          "name": "formhash",
          "re": "formhash(?:=|%3D)([A-Za-z0-9]{6,64})",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "只读筛选当前账号在固定签到主题中的回复；只有今天没有本人回复时才进入写操作。",
    "request": {
      "method": "GET",
      "url": "https://game.ali213.net/forum.php?mod=viewthread&tid=7098234&page=1&authorid={{account_uid|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://game.ali213.net/thread-7098234-1-1.html"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/id=[\"']fastpostform[\"']/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "/<title[^>]*>\\s*(?:Just a moment\\.\\.\\.|Attention Required|安全验证)[^<]*<\\/title>|<form[^>]+id=[\"']lsform[\"']|<div[^>]+id=[\"']challenge-form[\"']|您需要先登录|请先登录|您需要登录后|登录后.{0,20}(?:回复|发帖)|您没有权限|禁止匿名发帖/i",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "needs_reply",
          "re": "/\\A(?=[\\s\\S]*space-uid-{{account_uid}}\\.html)(?![\\s\\S]*id=[\"']authorposton\\d+[\"'][^>]*>[\\s\\S]{0,300}?{{date_time(1,0)[0:4]}}-0?{{date_time(1,0)[5:7]|int}}-0?{{date_time(1,0)[8:10]|int}})(?:[\\s\\S]*?)(id=[\"']fastpostform[\"'])/i",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "仅在本人今天尚未回复固定签到主题时进入一次性回帖分支。",
    "request": {
      "method": "GET",
      "url": "{% if needs_reply and account_uid and formhash %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "在固定签到主题提交一次当日回复；结果不确定时不重试，由后续本人回复复核。",
    "request": {
      "method": "POST",
      "url": "https://game.ali213.net/forum.php?mod=post&action=reply&fid=46&tid=7098234&extra=&replysubmit=yes&infloat=yes&handlekey=fastpost",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://game.ali213.net/thread-7098234-1-1.html"
        },
        {
          "name": "Origin",
          "value": "https://game.ali213.net"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&subject=&message={{ (date_time(1,0)[0:4] ~ '年' ~ (date_time(1,0)[5:7]|int) ~ '月' ~ (date_time(1,0)[8:10]|int) ~ '日签到')|urlencode }}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/每日签到|论坛每日签到|回复|发表|感谢/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "/<title[^>]*>\\s*(?:Just a moment\\.\\.\\.|Attention Required|安全验证)[^<]*<\\/title>|<form[^>]+id=[\"']lsform[\"']|<div[^>]+id=[\"']challenge-form[\"']|您需要先登录|请先登录|您需要登录后|您没有权限|禁止匿名发帖|回复需要审核|等待审核|审核后显示|两次回复间隔|请不要重复/i",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "本人今天尚未回复分支结束。",
    "request": {
      "method": "GET",
      "url": "{% endif %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "最终只读复核当前账号在固定签到主题中的今日回复；旧回复日期或他人回复不能算成功。",
    "request": {
      "method": "GET",
      "url": "https://game.ali213.net/forum.php?mod=viewthread&tid=7098234&page=1&authorid={{account_uid|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://game.ali213.net/thread-7098234-1-1.html"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/space-uid-{{account_uid}}\\.html[\\s\\S]{0,5000}?id=[\"']authorposton\\d+[\"'][^>]*>[\\s\\S]{0,300}?{{date_time(1,0)[0:4]}}-0?{{date_time(1,0)[5:7]|int}}-0?{{date_time(1,0)[8:10]|int}}[^<]{0,20}?\\d{1,2}:\\d{2}/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "/<title[^>]*>\\s*(?:Just a moment\\.\\.\\.|Attention Required|安全验证)[^<]*<\\/title>|<form[^>]+id=[\"']lsform[\"']|<div[^>]+id=[\"']challenge-form[\"']|您需要先登录|请先登录|您需要登录后|您没有权限|回复需要审核|等待审核|审核后显示/i",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "id=[\"']authorposton\\d+[\"'][^>]*>[\\s\\S]{0,300}?({{date_time(1,0)[0:4]}}-0?{{date_time(1,0)[5:7]|int}}-0?{{date_time(1,0)[8:10]|int}}[^<]{0,20}?\\d{1,2}:\\d{2})",
          "from": "content"
        }
      ]
    }
  }
]
