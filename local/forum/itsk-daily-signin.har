[
  {
    "comment": "读取 IT天空签到页并确认登录态",
    "request": {
      "method": "GET",
      "url": "https://www.itsk.com/dsu_paulsign-sign.html",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "href=[\"']space-uid-[1-9]\\d*\\.html[\"'][^>]*\\bid=[\"']m[\"']|action=logout",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|name=[\"']username[\"']|id=[\"']lsform[\"']|验证码|人机验证|滑块验证|安全验证|challenge|WZWS|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=[\"']formhash[\"']\\s+value=[\"']([^\"']+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交 IT天空每日签到",
    "request": {
      "method": "POST",
      "url": "https://www.itsk.com/plugin.php?id=dsu_paulsign%3Asign&operation=qiandao&infloat=1&inajax=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://www.itsk.com/dsu_paulsign-sign.html"
        },
        {
          "name": "Origin",
          "value": "https://www.itsk.com"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&qdxq=kx&qdmode=2&todaysay=&fastreply=6",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "签到成功|已经签到|今日已签到|重复签到|您今天已经签到|CDATA\\[[^\\]]*(?:签到|success)",
          "from": "content"
        },
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|签到失败|操作失败|系统错误|验证码|人机验证|滑块验证|安全验证|challenge|WZWS|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "复核 IT天空签到状态并读取奖励",
    "request": {
      "method": "GET",
      "url": "https://www.itsk.com/plugin.php?id=dsu_paulsign%3Asign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Referer",
          "value": "https://www.itsk.com/dsu_paulsign-sign.html"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "您今天已经签到过了|您上次签到时间|签到成功|已经签到",
          "from": "content"
        },
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|签到失败|操作失败|系统错误|验证码|人机验证|滑块验证|安全验证|challenge|WZWS|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "log_value",
          "re": "<font[^>]*><b>([^<]+)</b></font>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出签到结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=IT天空签到结果：{{log_value|default('已完成')|urlencode}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
