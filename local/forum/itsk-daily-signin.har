[
  {
    "comment": "生成 IT天空 WebAPI 的本次运行时间戳，用于构造一致的防重放请求头。使用登录 www.itsk.com 后的完整 Cookie 与同一浏览器的 User-Agent。",
    "request": {
      "method": "GET",
      "url": "api://util/timestamp",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "itsk_micro_ts",
          "re": "\"16位时间戳\"\\s*:\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "调用 IT天空 Nuxt WebAPI 完成每日签到。接口对当天已签到的账号会幂等返回 200，不会重复领取奖励。",
    "request": {
      "method": "GET",
      "url": "https://api.itsk.com/webapi/sign_activity",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Origin",
          "value": "https://www.itsk.com"
        },
        {
          "name": "Authorization",
          "value": "{{cookie|regex_search('(?<=itsk_access_token=)[^;]+')}}"
        },
        {
          "name": "X-Request-Timestamp",
          "value": "{{itsk_micro_ts[0:10]}}"
        },
        {
          "name": "X-Request-Nonce",
          "value": "{{to_uuid(itsk_micro_ts)|replace('-', '')}}"
        },
        {
          "name": "X-Request-Signature",
          "value": "{% set nonce = to_uuid(itsk_micro_ts)|replace('-', '') %}{{ (nonce[0:4] ~ itsk_micro_ts[0:10] ~ nonce[28:32] ~ nonce)|sha1 }}"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Referer",
          "value": "https://www.itsk.com/activity/sign"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"code\"\\s*:\\s*200",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(4|5)\\d\\d$",
          "from": "status"
        },
        {
          "re": "未登录|请登录|请先登录|登录已过期|登录失效|签名失败|签名错误|nonce|timestamp|验证码|人机验证|滑块验证|安全验证|challenge|WZWS|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "log_value",
          "re": "\"message\"\\s*:\\s*\"([^\"]+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出签到结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=IT天空签到完成：{{log_value|default('已完成')|urlencode}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
