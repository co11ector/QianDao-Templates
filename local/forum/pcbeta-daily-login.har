[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 bbs.pcbeta.com 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】只读访问远景论坛首页和积分页，确认同一账号仍处于登录状态并读取积分、PB币摘要；不会发帖、回复或领取其他奖励。\n\n【成功判定】首页和积分页都必须出现退出登录链接与当前账号的 discuz_uid，积分页还要包含积分或 PB币摘要；只返回首页标题不算成功。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 bbs.pcbeta.com 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】模板固定使用 Edge 网络指纹；遇到异常请求、滑块或安全验证页会直接失败关闭。",
    "request": {
      "method": "GET",
      "url": "https://bbs.pcbeta.com/forum.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"'])/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "异常请求验证|请求异常，请完成安全验证|检测到请求异常|拖动滑块验证|正在加载安全验证|access_(?:env|slide)_challenge|__access_review",
          "from": "content"
        },
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "account_uid",
          "re": "discuz_uid\\s*=\\s*[\"']([1-9]\\d*)[\"']",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "访问积分页触发并确认远景每日登录访问，要求同一账号仍处于登录态",
    "request": {
      "method": "GET",
      "url": "https://bbs.pcbeta.com/home.php?mod=spacecp&ac=credit&showcredit=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://bbs.pcbeta.com/forum.php"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"']{{account_uid}}[\"'])(?=[\\s\\S]*(?:PB币|积分))/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "异常请求验证|请求异常，请完成安全验证|检测到请求异常|拖动滑块验证|正在加载安全验证|access_(?:env|slide)_challenge|__access_review",
          "from": "content"
        },
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "points",
          "re": "积分[：:]\\s*(?:</?[^>]+>\\s*)*([^<\\s]+)",
          "from": "content"
        },
        {
          "name": "pb_coins",
          "re": "PB币[：:]\\s*(?:</?[^>]+>\\s*)*([^<\\s]+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出远景每日登录访问结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=远景论坛每日登录访问成功；积分：{{points|default('已确认')}}；PB币：{{pb_coins|default('已确认')}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
