[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 bbs.huorong.cn 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】只打开火绒安全论坛首页，确认账号已登录并读取页面中的金钱余额；不会进入任务中心、发帖或修改账号设置。\n\n【成功判定】首页必须同时出现退出登录状态和积分余额元素 hcredit_2；缺少任一项都不算成功。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 bbs.huorong.cn 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】登录失效、验证码、人机验证、安全检查或 Cloudflare 页面都会失败关闭。",
    "request": {
      "method": "GET",
      "url": "https://bbs.huorong.cn/",
      "headers": [
        {
          "name": "Host",
          "value": "bbs.huorong.cn"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Google Chrome\";v=\"103\", \"Chromium\";v=\"103\", \"Not=A?Brand\";v=\"24\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "navigate"
        },
        {
          "name": "Sec-Fetch-User",
          "value": "?1"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "document"
        },
        {
          "name": "Referer",
          "value": "https://bbs.huorong.cn/home.php?mod=space&do=notice&view=interactive&type=friend"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
            "re": "/(?=.*id=[\"']hcredit_2[\"']>\\s*[^<]+</span>)(?=.*(?:action=logout|退出))/is",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "您需要先登录|请先登录|登录后进行|member\\.php\\?mod=logging(?:&amp;|&)action=login|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "log_value",
          "re": "id=\"hcredit_2\">(.+?)</span>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成执行日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [],
      "cookies": [],
      "data": "content=金钱: {{log_value}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
