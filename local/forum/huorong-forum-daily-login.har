[
  {
    "comment": "访问论坛首页并确认登录态与每日登录奖励",
    "request": {
      "method": "GET",
      "url": "https://bbs.huorong.cn/",
      "headers": [
        {
          "name": "Host",
          "value": "bbs.huorong.cn"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Google Chrome\";v=\"103\", \"Chromium\";v=\"103\", \"Not=A?Brand\";v=\"24\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "navigate"
        },
        {
          "name": "Sec-Fetch-User",
          "value": "?1"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "document"
        },
        {
          "name": "Referer",
          "value": "https://bbs.huorong.cn/home.php?mod=space&do=notice&view=interactive&type=friend"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
            "re": "/(?=.*id=[\"']hcredit_2[\"']>\\s*[^<]+</span>)(?=.*(?:action=logout|退出))/is",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "您需要先登录|请先登录|登录后进行|member\\.php\\?mod=logging(?:&amp;|&)action=login|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "log_value",
          "re": "id=\"hcredit_2\">(.+?)</span>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成执行日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [],
      "cookies": [],
      "data": "content=金钱: {{log_value}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
