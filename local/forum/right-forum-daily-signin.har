[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 www.right.com.cn 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】只执行恩山论坛固定每日签到插件：先从论坛首页提取本人 UID 和动态 formhash，再向 erling_qd 签到接口提交一次，最后读取本人资料页复核登录态与恩山币。不会操作其他插件或帖子。\n\n【成功判定】首页必须同时包含 formhash、本人 space-uid 和退出登录状态；签到请求返回 200 且资料页仍显示同一账号的恩山币/用户组摘要。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 www.right.com.cn 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】签到失败、未登录、验证码、安全检查或 Cloudflare 页面都会失败关闭，不会伪造签到成功。",
    "request": {
      "method": "GET",
      "url": "https://www.right.com.cn/forum/forum.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
          {
            "re": "/(?=.*name=[\"']formhash[\"']\\s+value=[\"'][^\"']+)(?=.*space-uid-\\d+)(?=.*(?:action=logout|退出))/is",
          "from": "content"
        }
      ],
      "failed_asserts": [
          {
            "re": "您需要登录|请先登录|action=login|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=[\"']formhash[\"']\\s+value=[\"']([^\"']+)",
          "from": "content"
        },
        {
          "name": "uid",
          "re": "space-uid-(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交恩山每日签到并要求明确业务结果",
    "request": {
      "method": "POST",
      "url": "https://www.right.com.cn/forum/plugin.php?id=erling_qd%3Aaction&action=sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://www.right.com.cn/forum/forum.php"
        },
        {
          "name": "Origin",
          "value": "https://www.right.com.cn"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
            "re": "/(?:签到成功|已经签到|今日已签到|重复签到|签到完成|\\bsuccess\\b|\\balready\\b)/i",
          "from": "content"
        },
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
            "re": "您需要登录|请先登录|签到失败|操作失败|系统错误|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "读取资料页复核登录态与签到后的账户摘要",
    "request": {
      "method": "GET",
      "url": "https://www.right.com.cn/forum/home.php?mod=space&uid={{uid|urlencode}}&do=profile&mycenter=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
          {
            "re": "/(?=.*恩山币)(?=.*(?:action=logout|退出))/is",
          "from": "content"
        }
      ],
      "failed_asserts": [
          {
            "re": "您需要登录|请先登录|action=login|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "esb",
          "re": "恩山币<\\/em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "user",
          "re": "<h2[^>]*>\\s*([^<]+)",
          "from": "content"
        },
        {
          "name": "gid",
          "re": "用户组[^>]*>.*?<a[^>]*>([^<]+)</a>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出签到结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=用户名：{{user|default('未知')|urlencode}}，uid：{{uid|default('未知')|urlencode}}，用户组：{{gid|default('未知')|urlencode}}，恩山币：{{esb|default('未知')|urlencode}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
