[
  {
    "comment": "访问三宫六院首页并确认当前账号已登录",
    "request": {
      "method": "GET",
      "url": "https://www.sglynp.com/",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?:member|logging)\\.php\\?[^\"']*(?:mod=logging(?:&amp;|&)action=logout)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?:member|logging)\\.php\\?[^\"']*(?:mod=logging(?:&amp;|&)action=login)|name=[\"']username[\"']|id=[\"']lsform[\"']|用户登录页面|您需要先登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "只读访问积分页复核登录状态",
    "request": {
      "method": "GET",
      "url": "https://www.sglynp.com/home.php?mod=spacecp&ac=credit&showcredit=1",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://www.sglynp.com/"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?:member|logging)\\.php\\?[^\"']*(?:mod=logging(?:&amp;|&)action=logout)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?:member|logging)\\.php\\?[^\"']*(?:mod=logging(?:&amp;|&)action=login)|name=[\"']username[\"']|id=[\"']lsform[\"']|用户登录页面|您需要先登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "生成执行日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "content=三宫六院登录状态已确认（仅访问公开页面）",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
