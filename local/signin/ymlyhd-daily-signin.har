[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 www.ymlyhd.com 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】打开固定 DSU 签到页，确认登录并读取动态 formhash，随后只提交一次固定 qdxq=kx、空留言签到表单；最后重新打开签到页核对登录态和今日结果。不会发帖或操作其他插件。\n\n【成功判定】提交回执必须明确为签到成功、已经签到或今日已签到；复核页还必须保持退出登录状态并再次出现今日签到结果。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 www.ymlyhd.com 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】验证码、人机验证、安全检查、Cloudflare、非法字符或登录失效都会失败关闭。",
    "request": {
      "method": "GET",
      "url": "https://www.ymlyhd.com/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
          {
            "re": "/(?=.*name=[\"']formhash[\"']\\s+value=[\"'][^\"']+)(?=.*(?:action=logout|退出))/is",
            "from": "content"
          }
      ],
      "failed_asserts": [
        {
            "re": "(您需要先登录|请先登录|登录后进行|member\\.php\\?mod=logging(?:&amp;|&)action=login|验证码|人机验证|安全检查|Just a moment|Cloudflare)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=\"formhash\" value=\"(.*?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交每日签到并要求明确业务结果",
    "request": {
      "method": "POST",
      "url": "https://www.ymlyhd.com/plugin.php?id=dsu_paulsign:sign&operation=qiandao&infloat=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://www.ymlyhd.com/plugin.php?id=dsu_paulsign:sign"
        },
        {
          "name": "Origin",
          "value": "https://www.ymlyhd.com"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&qdxq=kx&qdmode=3&todaysay=",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
            "re": "/(?:签到成功|已经签到|今日已签到|已经签过|您今天已经签到过了)/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "(您需要先登录|请先登录|登录后进行|非法字符|未定义操作|验证码|人机验证|安全检查|Just a moment|Cloudflare)",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "复查登录态并确认今日签到成功",
    "request": {
      "method": "GET",
      "url": "https://www.ymlyhd.com/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
            "re": "/(?=.*(?:签到成功|已经签到|今日已签到|已经签过|您今天已经签到过了))(?=.*(?:action=logout|退出))/is",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "(您需要先登录|请先登录|登录后进行|验证码|人机验证|安全检查|Just a moment|Cloudflare)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "(签到成功|已经签到|今日已签到|已经签过|您今天已经签到过了)",
          "from": "content"
        }
      ]
    }
  }
]
