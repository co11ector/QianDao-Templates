[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 www.smzdm.com 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】只执行什么值得买固定签到流程：\n1. 使用固定客户端参数和本次时间戳申请一次性 robot token；\n2. 使用该 token 提交一次签到，并生成配套请求签名；\n3. 读取连续签到天数、金币、碎银和站点消息写入日志。\n不会浏览商品、爆料、评论或修改账号资料。\n\n【成功判定】token 接口必须返回 error_code=0 且带非空 token；签到接口必须返回 error_code=0，并尽量读到连续签到天数与奖励摘要。token 只在本次运行内存中使用。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 www.smzdm.com 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】任何非零 error_code、登录失效、身份验证、验证码、安全验证或风控提示都会失败关闭。",
    "request": {
      "method": "POST",
      "url": "https://user-api.smzdm.com/robot/token",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "application/json,text/plain,*/*"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "{% set ts = (timestamp()|int * 1000) %}f=android&v=10.4.1&weixin=1&time={{ts}}&sign={{(\"f=android&time=\" ~ (ts|string) ~ \"&v=10.4.1&weixin=1&key=apr1$AwP!wRRT$gJ/q.X24poeBInlUJC\")|md5|upper}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?0\"?[\\s\\S]*\"token\"\\s*:\\s*\"[^\"]+\"",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?(?!0\"?(?:\\s*[,}]))-?\\d+\"?",
          "from": "content"
        },
        {
          "re": "\"error_msg\"\\s*:\\s*\"[^\"]*(?:登录|未登录|失效|身份验证|验证码|安全验证|风控)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "robot_token",
          "re": "\"token\"\\s*:\\s*\"([^\"]+)\"",
          "from": "content"
        },
        {
          "name": "token_msg",
          "re": "\"error_msg\"\\s*:\\s*\"([^\"]*)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "使用一次性机器人 token 提交什么值得买签到，并读取连续签到、金币和碎银结果",
    "request": {
      "method": "POST",
      "url": "https://user-api.smzdm.com/checkin",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "application/json,text/plain,*/*"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "{% set ts = (timestamp()|int * 1000) %}{% set sk = \"ierkM0OZZbsuBKLoAgQ6OJneLMXBQXmzX+LXkNTuKch8Ui2jGlahuFyWIzBiDq/L\" %}{% set token = robot_token %}f=android&v=10.4.1&sk={{sk|urlencode}}&weixin=1&time={{ts}}&token={{token|urlencode}}&sign={{(\"f=android&sk=\" ~ sk ~ \"&time=\" ~ (ts|string) ~ \"&token=\" ~ token ~ \"&v=10.4.1&weixin=1&key=apr1$AwP!wRRT$gJ/q.X24poeBInlUJC\")|md5|upper}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?0\"?",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?(?!0\"?(?:\\s*[,}]))-?\\d+\"?",
          "from": "content"
        },
        {
          "re": "\"error_msg\"\\s*:\\s*\"[^\"]*(?:登录|未登录|失效|身份验证|验证码|安全验证|风控)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "daily_num",
          "re": "\"daily_num\"\\s*:\\s*\"?(\\d+)",
          "from": "content"
        },
        {
          "name": "cgold",
          "re": "\"cgold\"\\s*:\\s*\"?(-?\\d+)",
          "from": "content"
        },
        {
          "name": "pre_re_silver",
          "re": "\"pre_re_silver\"\\s*:\\s*\"?(-?\\d+)",
          "from": "content"
        },
        {
          "name": "checkin_msg",
          "re": "\"error_msg\"\\s*:\\s*\"([^\"]+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出什么值得买签到结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=什么值得买签到完成 - {{checkin_msg|default('签到成功')}} - 连续签到:{{daily_num|default('0')}} 天 - 金币:{{cgold|default('0')}} - 银元:{{pre_re_silver|default('0')}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
