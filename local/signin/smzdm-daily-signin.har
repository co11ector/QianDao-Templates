[
  {
    "comment": "使用登录后的完整 Cookie 与同一浏览器 User-Agent 获取什么值得买机器人 token；只执行固定签到流程，遇到登录失效或人工验证会失败关闭",
    "request": {
      "method": "POST",
      "url": "https://user-api.smzdm.com/robot/token",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "application/json,text/plain,*/*"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "{% set ts = (timestamp()|int * 1000) %}f=android&v=10.4.1&weixin=1&time={{ts}}&sign={{(\"f=android&time=\" ~ (ts|string) ~ \"&v=10.4.1&weixin=1&key=apr1$AwP!wRRT$gJ/q.X24poeBInlUJC\")|md5|upper}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?0\"?[\\s\\S]*\"token\"\\s*:\\s*\"[^\"]+\"",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?(?!0\"?(?:\\s*[,}]))-?\\d+\"?",
          "from": "content"
        },
        {
          "re": "\"error_msg\"\\s*:\\s*\"[^\"]*(?:登录|未登录|失效|身份验证|验证码|安全验证|风控)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "robot_token",
          "re": "\"token\"\\s*:\\s*\"([^\"]+)\"",
          "from": "content"
        },
        {
          "name": "token_msg",
          "re": "\"error_msg\"\\s*:\\s*\"([^\"]*)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "使用一次性机器人 token 提交什么值得买签到，并读取连续签到、金币和碎银结果",
    "request": {
      "method": "POST",
      "url": "https://user-api.smzdm.com/checkin",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "application/json,text/plain,*/*"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "{% set ts = (timestamp()|int * 1000) %}{% set sk = \"ierkM0OZZbsuBKLoAgQ6OJneLMXBQXmzX+LXkNTuKch8Ui2jGlahuFyWIzBiDq/L\" %}{% set token = robot_token %}f=android&v=10.4.1&sk={{sk|urlencode}}&weixin=1&time={{ts}}&token={{token|urlencode}}&sign={{(\"f=android&sk=\" ~ sk ~ \"&time=\" ~ (ts|string) ~ \"&token=\" ~ token ~ \"&v=10.4.1&weixin=1&key=apr1$AwP!wRRT$gJ/q.X24poeBInlUJC\")|md5|upper}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?0\"?",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?(?!0\"?(?:\\s*[,}]))-?\\d+\"?",
          "from": "content"
        },
        {
          "re": "\"error_msg\"\\s*:\\s*\"[^\"]*(?:登录|未登录|失效|身份验证|验证码|安全验证|风控)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "daily_num",
          "re": "\"daily_num\"\\s*:\\s*\"?(\\d+)",
          "from": "content"
        },
        {
          "name": "cgold",
          "re": "\"cgold\"\\s*:\\s*\"?(-?\\d+)",
          "from": "content"
        },
        {
          "name": "pre_re_silver",
          "re": "\"pre_re_silver\"\\s*:\\s*\"?(-?\\d+)",
          "from": "content"
        },
        {
          "name": "checkin_msg",
          "re": "\"error_msg\"\\s*:\\s*\"([^\"]+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出什么值得买签到结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=什么值得买签到完成 - {{checkin_msg|default('签到成功')}} - 连续签到:{{daily_num|default('0')}} 天 - 金币:{{cgold|default('0')}} - 银元:{{pre_re_silver|default('0')}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
