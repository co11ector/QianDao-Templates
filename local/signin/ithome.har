[
  {
    "comment": "IT之家每日签到。使用登录 www.ithome.com 后的完整 Cookie 与同一浏览器的 User-Agent；签到所需的 jwtuser 从该 Cookie 中即时提取，不单独保存 token。Cookie 过期后重新用 QianDao Cookie Extractor 获取这一组成对身份即可。重复执行只会回复今日已签到，不会重复领取金币。",
    "request": {
      "method": "GET",
      "url": "https://napi.ithome.com/api/usersign/sign?userHash=Bearer%20{{cookie|regex_search('(?<=jwtuser=)[^;]+')|replace('Bearer%20','')|replace('Bearer+','')|replace('Bearer ','')|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-Hans-CN;q=1, en-US;q=0.9"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"ok\":(0|1)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(4|5)\\d\\d$",
          "from": "status"
        },
        {
          "re": "未登录|请登录|请先登录|登录已过期|凭证",
          "from": "content"
        }
      ]
    }
  }
]
