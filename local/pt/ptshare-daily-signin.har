[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 www.ptshare.org 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】打开固定 DSU 签到页，读取动态 formhash 和本人账号，提交一次固定短语“每日签到”，然后重新打开签到页核对同一账号的今日签到时间；不会访问种子列表或修改账号设置。\n\n【成功判定】首次页面必须已登录；提交返回 200 后，复核页必须仍为同一 account_uid，并显示本人今天可验证的签到时间，而不是排行榜或昨日记录。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 www.ptshare.org 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】该站点当前使用固定 HTTP 地址，Cookie 会通过未加密连接发送，请只在可信网络环境运行；formhash 错误、非法字符或安全验证都会失败关闭。",
    "request": {
      "method": "GET",
      "url": "http://www.ptshare.org/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "from": "content",
          "re": "(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"'])(?=[\\s\\S]*href=[\"'](?:https?://[^/\"']+/)?member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=[a-fA-F0-9]{8}[\"'])[\\s\\S]*?(?:<form\\b(?=[^>]*\\bid=[\"']qiandao[\"'])[^>]*>(?=(?:(?!</form>)[\\s\\S])*?(?:<input|<textarea|<select)\\b(?=[^>]*\\bname=[\"']todaysay[\"']))(?=(?:(?!</form>)[\\s\\S])*?<input\\b(?=[^>]*\\bname=[\"']qdmode[\"'])(?=[^>]*\\bvalue=[\"']1[\"']))(?:(?!</form>)[\\s\\S])*?</form>|<div\\b[^>]*\\bclass=[\"'][^\"']*\\bmn\\b[^\"']*[\"'][^>]*>\\s*<h1\\b[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h[1-6]\\b|</div>)[\\s\\S])*?您上次签到时间[：:]\\s*<font\\b[^>]*>({{1|date_time(0)}} \\d{2}:\\d{2}(?::\\d{2})?)</font>)"
        }
      ],
      "failed_asserts": [
        {
          "from": "content",
          "re": "id=[\"']lsform[\"']|name=[\"']username[\"']|您需要先登录|请先登录|<title>[^<]*(?:Just a moment|Attention Required)|id=[\"']challenge-form[\"']"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "from": "content",
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=([a-fA-F0-9]{8})[\"']"
        },
        {
          "name": "account_uid",
          "from": "content",
          "re": "discuz_uid\\s*=\\s*[\"']([1-9]\\d*)[\"']"
        }
      ]
    }
  },
  {
    "comment": "提交一次固定 DSU 签到短语“每日签到”；最终结果以刷新复核为准",
    "request": {
      "method": "POST",
      "url": "http://www.ptshare.org/plugin.php?id=dsu_paulsign:sign&operation=qiandao&infloat=1&sign_as=1&inajax=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "http://www.ptshare.org/plugin.php?id=dsu_paulsign:sign"
        },
        {
          "name": "Origin",
          "value": "http://www.ptshare.org"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&qdxq=kx&qdmode=1&todaysay=每日签到&fastreply=0",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "from": "status",
          "re": "^200$"
        }
      ],
      "failed_asserts": [
        {
          "from": "content",
          "re": "id=[\"']lsform[\"']|name=[\"']username[\"']|您需要先登录|请先登录|<title>[^<]*(?:Just a moment|Attention Required)|id=[\"']challenge-form[\"']|非法字符|未定义操作|formhash.*(?:无效|错误)"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "刷新核验同一账号的当天签到时间，排除排行榜和昨日记录",
    "request": {
      "method": "GET",
      "url": "http://www.ptshare.org/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "from": "content",
          "re": "(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"'])(?=[\\s\\S]*href=[\"'](?:https?://[^/\"']+/)?member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=[a-fA-F0-9]{8}[\"'])(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"']{{account_uid}}[\"'])[\\s\\S]*?<div\\b[^>]*\\bclass=[\"'][^\"']*\\bmn\\b[^\"']*[\"'][^>]*>\\s*<h1\\b[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h[1-6]\\b|</div>)[\\s\\S])*?您上次签到时间[：:]\\s*<font\\b[^>]*>({{1|date_time(0)}} \\d{2}:\\d{2}(?::\\d{2})?)</font>"
        }
      ],
      "failed_asserts": [
        {
          "from": "content",
          "re": "id=[\"']lsform[\"']|name=[\"']username[\"']|您需要先登录|请先登录|<title>[^<]*(?:Just a moment|Attention Required)|id=[\"']challenge-form[\"']"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "from": "content",
          "re": "<div\\b[^>]*\\bclass=[\"'][^\"']*\\bmn\\b[^\"']*[\"'][^>]*>\\s*<h1\\b[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h[1-6]\\b|</div>)[\\s\\S])*?您上次签到时间[：:]\\s*<font\\b[^>]*>(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}(?::\\d{2})?)</font>"
        }
      ]
    }
  }
]
