  {
    "comment": "完成漫画签到并接受站点明确的重复结果",
    "request": {
      "method": "POST",
      "url": "https://manga.bilibili.com/twirp/activity.v1.Activity/ClockIn",
      "headers": [
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "platform=ios",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/\"code\"\\s*:\\s*0|不能重复签到|clockin clockin is duplicate/s",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "/\"code\"\\s*:\\s*-[1-9]\\d*|未登录|账号未登录|验证码|人机验证|安全检查|Just a moment|Cloudflare/s",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
