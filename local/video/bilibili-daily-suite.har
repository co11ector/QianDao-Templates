  {
    "comment": "读取账号等级与硬币",
    "request": {
      "method": "GET",
      "url": "https://api.bilibili.com/x/web-interface/nav",
      "headers": [
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Origin",
          "value": "https://account.bilibili.com"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-site"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
            "re": "/(?=.*\"code\"\\s*:\\s*0)(?=.*\"isLogin\"\\s*:\\s*true)(?=.*\"mid\"\\s*:\\s*\\d+)/s",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "\"isLogin\"\\s*:\\s*false|\"code\"\\s*:\\s*-[1-9]\\d*|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "level",
          "re": "\"current_level\":(.*?),\"",
          "from": "content"
        },
        {
          "name": "coin",
          "re": "\"money\":(.*?),\"",
          "from": "content"
        },
        {
          "name": "uid",
          "re": "\"mid\":(.*?),\"",
          "from": "content"
        },
        {
          "name": "exp",
          "re": "\"current_exp\":(.*?),",
          "from": "content"
        },
        {
          "name": "uname",
          "re": "uname\":\"(.*?)\",",
          "from": "content"
        }
      ]
    }
  },
