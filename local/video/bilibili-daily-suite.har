[
  {
    "comment": "读取热门视频并提取 BVID",
    "request": {
      "method": "GET",
      "url": "https://api.bilibili.com/x/web-interface/popular?pn=1&ps=20",
      "headers": [
        {
          "name": "Host",
          "value": "api.bilibili.com"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Origin",
          "value": "https://www.bilibili.com"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-site"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Referer",
          "value": "https://www.bilibili.com/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=.*\"code\"\\s*:\\s*0)(?=.*\"bvid\"\\s*:\\s*\"BV[A-Za-z0-9]{10}\")/s",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"code\"\\s*:\\s*-[1-9]\\d*",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "BV",
          "re": "(BV[A-Za-z0-9]{10})",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "访问 B 站首页并确认页面未进入登录/挑战态",
    "request": {
      "method": "GET",
      "url": "https://www.bilibili.com/",
      "headers": [
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Cache-Control",
          "value": "max-age=0"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-site"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "navigate"
        },
        {
          "name": "Sec-Fetch-User",
          "value": "?1"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "document"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "哔哩哔哩|bilibili",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(\"isLogin\"\\s*:\\s*false|账号未登录|登录状态失效|验证码|人机验证|安全检查|Just a moment|Cloudflare)",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "等待 10 秒",
    "request": {
      "method": "GET",
      "url": "api://util/delay/10",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "delay 10(?:\\.0)? second\\.",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "Error",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "从 Cookie 提取 bili_jct",
    "request": {
      "method": "GET",
      "url": "api://util/regex?p=bili_jct%3D(.*%3F)%3B&data={{cookie|urlencode}}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"OK\"",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"(?!OK)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "bili_jct",
          "re": "\"1\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "完成每日分享任务并接受站点明确的重复结果",
    "request": {
      "method": "POST",
      "url": "https://api.bilibili.com/x/web-interface/share/add",
      "headers": [
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "bvid={{BV}}&csrf={{bili_jct}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/\"code\"\\s*:\\s*0|(?=.*\"code\"\\s*:\\s*71000)(?=.*重复分享)/s",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "\"code\"\\s*:\\s*-[1-9]\\d*|未登录|账号未登录|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "等待 10 秒",
    "request": {
      "method": "GET",
      "url": "api://util/delay/10",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "delay 10(?:\\.0)? second\\.",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "Error",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "提交观看心跳并要求站点成功回执",
    "request": {
      "method": "POST",
      "url": "https://api.bilibili.com/x/click-interface/web/heartbeat",
      "headers": [
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "bvid={{BV}}&csrf={{bili_jct}}&played_time=2",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"code\"\\s*:\\s*0",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "\"code\"\\s*:\\s*-[1-9]\\d*|未登录|账号未登录|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
