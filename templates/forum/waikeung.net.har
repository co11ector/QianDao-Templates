[
  {
    "request": {
      "method": "GET",
      "url": "https://waikeung.net/plugin.php?id=k_misign%3Asign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "name=\"formhash\" value=\"(.+)\"",
          "from": "content",
          "name": "formhash"
        },
        {
          "name": "uid",
          "re": "discuz_uid = '(\\d+)'",
          "from": "content"
        }
      ]
    },
    "comment": "waikeung.net"
  },
  {
    "request": {
      "method": "GET",
      "url": "https://waikeung.net/plugin.php?id=k_misign%3Asign&operation=qiandao&formhash={{formhash|urlencode}}&format=empty",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "",
    "request": {
      "method": "GET",
      "url": "https://waikeung.net/plugin.php?id=k_misign%3Asign&operation=qiandao&formhash={{formhash|urlencode}}&format=empty",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "今日已",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "https://waikeung.net/home.php?mod=space&uid={{uid|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "(上次活動時間.+?)<",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
]
