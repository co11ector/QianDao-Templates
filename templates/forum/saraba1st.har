  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "content={{QD}}:积分{{JF}},距下级{{XY}}分,还需要{{divide(XY,240)| replace(\"000\",\"\")| replace(\"333\",\"\")|urlencode}}天,{{ZDL}},{{SY}},{{RP}}"
