[
  {
    "request": {
      "method": "GET",
      "url": "https://www.chiphell.com/forum.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "DNT",
          "value": "1"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, sdch"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.8,zh-TW;q=0.6"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Referer",
          "value": "https://www.chiphell.com/portal.php"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "用户组",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": ">积分: (.+)</a>",
          "from": "content",
          "name": "jifen"
        }
      ]
    }
  },
  {
    "comment": "生成日志",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=%C2%A0&p=%C2%A0&s=%E5%BD%93%E5%89%8D%E7%A7%AF%E5%88%86%E4%B8%BA%3A%20{{jifen|urlencode}}%C2%A0",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": ".+",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
]
