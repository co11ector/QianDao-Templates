[
  {
    "comment": "",
    "request": {
      "method": "GET",
      "url": "https://ssdforum.org/forum.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "立即注册|自动登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=\"formhash\" value=\"(.+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "https://ssdforum.org/plugin.php?id=dsu_paulsign%3Asign&operation=qiandao&infloat=1&sign_as=1&inajax=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "origin",
          "value": "https://ssdforum.org"
        },
        {
          "name": "referer",
          "value": "https://ssdforum.org/"
        }
      ],
      "data": "formhash={{formhash}}&qdxq=kx&qdmode=1&todaysay=hello hello&fastreply=0",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录才能继续本操作",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "msg",
          "re": "(.*)<\\/div>",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "https://ssdforum.org/plugin.php?id=dsu_paulsign%3Asign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录才能继续本操作",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "name",
          "re": "title=\"访问我的空间\">(.*)</a>",
          "from": "content"
        },
        {
          "name": "ljqd",
          "re": "您累计已签到.*?<b>(.*?)</b>",
          "from": "content"
        },
        {
          "name": "byqd",
          "re": "您本月已累计签到.*?<b>(.*?)</b>",
          "from": "content"
        },
        {
          "name": "scqd",
          "re": "您上次签到时间.*<font color=\".*\">(.*)</font>",
          "from": "content"
        },
        {
          "name": "zjl",
          "re": "您目前获得的总奖励为.*?<b>(.*?)</b>",
          "from": "content"
        },
        {
          "name": "scjl",
          "re": "上次获得的奖励为.*?<b>(.*?)</b>",
          "from": "content"
        },
        {
          "name": "mqdj",
          "re": "您目前的等级.*?<b>(.*?)</b>",
          "from": "content"
        },
        {
          "name": "zqd",
          "re": "您只需再签到.*?<b>(.*?)</b>",
          "from": "content"
        },
        {
          "name": "xgdj",
          "re": "下一个等级.*?<b>(.*?)</b>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "content={{msg}}\\r\\n {{name}} , 您累计已签到：{{ljqd}} 天\\r\\n 您本月已累计签到：{{byqd}} 天\\r\\n 您上次签到时间：{{scqd}}\\r\\n 您目前获得的总奖励为：威望 {{zjl}} ，上次获得的奖励为：威望 {{scjl}} \\r\\n 您目前的等级：{{mqdj}}\\r\\n Tips：您只需再签到 {{zqd}} 天就可以提升到下一个等级：{{xgdj}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
