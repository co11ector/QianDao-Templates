[
  {
    "comment": "使用 Cookie 与同一浏览器 User-Agent 访问远景论坛首页，确认退出链接和当前账号 UID；全程只读",
    "request": {
      "method": "GET",
      "url": "https://bbs.pcbeta.com/forum.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"'])/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "异常请求验证|请求异常，请完成安全验证|检测到请求异常|拖动滑块验证|正在加载安全验证|access_(?:env|slide)_challenge|__access_review",
          "from": "content"
        },
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "account_uid",
          "re": "discuz_uid\\s*=\\s*[\"']([1-9]\\d*)[\"']",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "访问积分页触发并确认远景每日登录访问，要求同一账号仍处于登录态",
    "request": {
      "method": "GET",
      "url": "https://bbs.pcbeta.com/home.php?mod=spacecp&ac=credit&showcredit=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://bbs.pcbeta.com/forum.php"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"']{{account_uid}}[\"'])(?=[\\s\\S]*(?:PB币|积分))/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "异常请求验证|请求异常，请完成安全验证|检测到请求异常|拖动滑块验证|正在加载安全验证|access_(?:env|slide)_challenge|__access_review",
          "from": "content"
        },
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "points",
          "re": "积分[：:]\\s*(?:</?[^>]+>\\s*)*([^<\\s]+)",
          "from": "content"
        },
        {
          "name": "pb_coins",
          "re": "PB币[：:]\\s*(?:</?[^>]+>\\s*)*([^<\\s]+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出远景每日登录访问结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=远景论坛每日登录访问成功；积分：{{points|default('已确认')}}；PB币：{{pb_coins|default('已确认')}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
