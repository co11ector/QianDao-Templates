[
  {
    "comment": "读取当前账号状态",
    "request": {
      "method": "GET",
      "url": "https://bbs.acgrip.com/dsu_paulsign-sign.html",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "href=[\"\\']space-uid-[1-9]\\d*\\.html[\"\\'][^>]*\\bid=[\"\\']m[\"\\']",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|name=[\"\\']username[\"\\']|id=[\"\\']lsform[\"\\']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=[\"\\']formhash[\"\\']\\s+value=[\"\\']([a-fA-F0-9]{8})[\"\\']",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交每日签到，不填写留言",
    "request": {
      "method": "POST",
      "url": "https://bbs.acgrip.com/plugin.php?id=dsu_paulsign:sign&operation=qiandao&infloat=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://bbs.acgrip.com/dsu_paulsign-sign.html"
        },
        {
          "name": "Origin",
          "value": "https://bbs.acgrip.com"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&qdxq=kx&qdmode=3&todaysay=&fastreply=0",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "^200$",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|name=[\"\\']username[\"\\']|id=[\"\\']lsform[\"\\']",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "读取当前账号状态",
    "request": {
      "method": "GET",
      "url": "https://bbs.acgrip.com/dsu_paulsign-sign.html",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?=[\\s\\S]*href=[\"\\']space-uid-[1-9]\\d*\\.html[\"\\'][^>]*\\bid=[\"\\']m[\"\\'])[\\s\\S]*?class=[\"\\']mn[\"\\'][^>]*>\\s*<h1[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h1|</div>)[\\s\\S])*?您上次签到时间:\\s*<font[^>]*>({{1|date_time(0)}} \\d{2}:\\d{2})</font>",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|name=[\"\\']username[\"\\']|id=[\"\\']lsform[\"\\']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "class=[\"\\']mn[\"\\'][^>]*>\\s*<h1[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h1|</div>)[\\s\\S])*?您上次签到时间:\\s*<font[^>]*>(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2})</font>",
          "from": "content"
        }
      ]
    }
  }
]
