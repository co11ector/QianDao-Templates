[
  {
    "comment": "通过严格 CA 校验的 Chrome 网络指纹访问论坛首页并触发每日登录奖励",
    "request": {
      "method": "GET",
      "url": "https://www.chiphell.com/forum.php",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "action=logout(?:&amp;|&)formhash=[A-Za-z0-9]+",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|登录后进行",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "uid",
          "re": "(?:home\\.php\\?mod=space(?:&amp;|&)uid=|space-uid-)([1-9]\\d*)",
          "from": "content"
        },
        {
          "name": "username",
          "re": "/class=[\"']vwmy[\"'][^>]*>.*?<a[^>]*>([^<]+)</s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "读取账户积分摘要",
    "request": {
      "method": "GET",
      "url": "https://www.chiphell.com/home.php?mod=spacecp&ac=credit&showcredit=1",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://www.chiphell.com/forum.php"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "action=logout(?:&amp;|&)formhash=[A-Za-z0-9]+",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|请先登录|登录后进行",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "points",
          "re": "/积分:</em>\\s*([^<\\r\\n]+)/s",
          "from": "content"
        },
        {
          "name": "evil_points",
          "re": "/邪恶指数:</em>\\s*([^<\\r\\n]+)/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成执行日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "content=Chiphell每日登录访问成功，账号: {{username|default('未知')|urlencode}}，UID: {{uid|default('未知')|urlencode}}，积分: {{points|default('未知')|urlencode}}，邪恶指数: {{evil_points|default('未知')|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
