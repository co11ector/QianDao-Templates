[
  {
    "comment": "读取论坛首页并确认登录态与动态签到参数",
    "request": {
      "method": "GET",
      "url": "https://www.right.com.cn/forum/forum.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
          {
            "re": "/(?=.*name=[\"']formhash[\"']\\s+value=[\"'][^\"']+)(?=.*space-uid-\\d+)(?=.*(?:action=logout|退出))/is",
          "from": "content"
        }
      ],
      "failed_asserts": [
          {
            "re": "您需要登录|请先登录|action=login|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=[\"']formhash[\"']\\s+value=[\"']([^\"']+)",
          "from": "content"
        },
        {
          "name": "uid",
          "re": "space-uid-(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交恩山每日签到并要求明确业务结果",
    "request": {
      "method": "POST",
      "url": "https://www.right.com.cn/forum/plugin.php?id=erling_qd%3Aaction&action=sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://www.right.com.cn/forum/forum.php"
        },
        {
          "name": "Origin",
          "value": "https://www.right.com.cn"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
            "re": "/(?:签到成功|已经签到|今日已签到|重复签到|签到完成|\\bsuccess\\b|\\balready\\b)/i",
          "from": "content"
        },
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
            "re": "您需要登录|请先登录|签到失败|操作失败|系统错误|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "读取资料页复核登录态与签到后的账户摘要",
    "request": {
      "method": "GET",
      "url": "https://www.right.com.cn/forum/home.php?mod=space&uid={{uid|urlencode}}&do=profile&mycenter=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
          {
            "re": "/(?=.*恩山币)(?=.*(?:action=logout|退出))/is",
          "from": "content"
        }
      ],
      "failed_asserts": [
          {
            "re": "您需要登录|请先登录|action=login|验证码|人机验证|安全检查|Just a moment|Cloudflare",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "esb",
          "re": "恩山币<\\/em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "user",
          "re": "<h2[^>]*>\\s*([^<]+)",
          "from": "content"
        },
        {
          "name": "gid",
          "re": "用户组[^>]*>.*?<a[^>]*>([^<]+)</a>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出签到结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=用户名：{{user|default('未知')|urlencode}}，uid：{{uid|default('未知')|urlencode}}，用户组：{{gid|default('未知')|urlencode}}，恩山币：{{esb|default('未知')|urlencode}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
