[
  {
    "comment": "读取SSDForum登录状态；接受需要固定短语的签到表单或本人今日已签到页面",
    "request": {
      "method": "GET",
      "url": "https://ssdforum.org/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "from": "content",
          "re": "(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"'])(?=[\\s\\S]*href=[\"'](?:https?://[^/\"']+/)?member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=[a-fA-F0-9]{8}[\"'])[\\s\\S]*?(?:<form\\b(?=[^>]*\\bid=[\"']qiandao[\"'])[^>]*>(?=(?:(?!</form>)[\\s\\S])*?(?:<input|<textarea|<select)\\b(?=[^>]*\\bname=[\"']todaysay[\"']))(?=(?:(?!</form>)[\\s\\S])*?<input\\b(?=[^>]*\\bname=[\"']qdmode[\"'])(?=[^>]*\\bvalue=[\"']1[\"']))(?:(?!</form>)[\\s\\S])*?</form>|<div\\b[^>]*\\bclass=[\"'][^\"']*\\bmn\\b[^\"']*[\"'][^>]*>\\s*<h1\\b[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h[1-6]\\b|</div>)[\\s\\S])*?您上次签到时间[：:]\\s*<font\\b[^>]*>({{1|date_time(0)}} \\d{2}:\\d{2}(?::\\d{2})?)</font>)"
        }
      ],
      "failed_asserts": [
        {
          "from": "content",
          "re": "id=[\"']lsform[\"']|name=[\"']username[\"']|您需要先登录|请先登录|<title>[^<]*(?:Just a moment|Attention Required)|id=[\"']challenge-form[\"']"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "from": "content",
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=([a-fA-F0-9]{8})[\"']"
        },
        {
          "name": "account_uid",
          "from": "content",
          "re": "discuz_uid\\s*=\\s*[\"']([1-9]\\d*)[\"']"
        }
      ]
    }
  },
  {
    "comment": "提交一次固定 DSU 签到短语“每日签到”；最终结果以刷新复核为准",
    "request": {
      "method": "POST",
      "url": "https://ssdforum.org/plugin.php?id=dsu_paulsign:sign&operation=qiandao&infloat=1&sign_as=1&inajax=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://ssdforum.org/plugin.php?id=dsu_paulsign:sign"
        },
        {
          "name": "Origin",
          "value": "https://ssdforum.org"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&qdxq=kx&qdmode=1&todaysay=每日签到&fastreply=0",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "from": "status",
          "re": "^200$"
        }
      ],
      "failed_asserts": [
        {
          "from": "content",
          "re": "id=[\"']lsform[\"']|name=[\"']username[\"']|您需要先登录|请先登录|<title>[^<]*(?:Just a moment|Attention Required)|id=[\"']challenge-form[\"']|非法字符|未定义操作|formhash.*(?:无效|错误)"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "刷新核验同一账号的当天签到时间，排除排行榜和昨日记录",
    "request": {
      "method": "GET",
      "url": "https://ssdforum.org/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "from": "content",
          "re": "(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"'])(?=[\\s\\S]*href=[\"'](?:https?://[^/\"']+/)?member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=[a-fA-F0-9]{8}[\"'])(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"']{{account_uid}}[\"'])[\\s\\S]*?<div\\b[^>]*\\bclass=[\"'][^\"']*\\bmn\\b[^\"']*[\"'][^>]*>\\s*<h1\\b[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h[1-6]\\b|</div>)[\\s\\S])*?您上次签到时间[：:]\\s*<font\\b[^>]*>({{1|date_time(0)}} \\d{2}:\\d{2}(?::\\d{2})?)</font>"
        }
      ],
      "failed_asserts": [
        {
          "from": "content",
          "re": "id=[\"']lsform[\"']|name=[\"']username[\"']|您需要先登录|请先登录|<title>[^<]*(?:Just a moment|Attention Required)|id=[\"']challenge-form[\"']"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "from": "content",
          "re": "<div\\b[^>]*\\bclass=[\"'][^\"']*\\bmn\\b[^\"']*[\"'][^>]*>\\s*<h1\\b[^>]*>您今天已经签到过了或者签到时间还未开始</h1>(?:(?!<h[1-6]\\b|</div>)[\\s\\S])*?您上次签到时间[：:]\\s*<font\\b[^>]*>(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}(?::\\d{2})?)</font>"
        }
      ]
    }
  }
]
