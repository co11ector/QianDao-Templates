[
  {
    "request": {
      "method": "POST",
      "url": "https://www.t00ls.com/login.json",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ],
      "data": "action=login&username={{username}}&password={{password}}&questionid={{questionid}}&answer={{answer}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "\\\"cookie\\\"\\:{(.+)}}",
          "from": "content",
          "name": "cookie"
        }
      ]
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "https://www.t00ls.com/members-profile.json",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "\\\"uid\\\"\\:\\\"(\\d+)\\\"",
          "from": "content",
          "name": "uid"
        },
        {
          "re": "\\\"formhash\\\"\\:\\\"(.+)\\\"",
          "from": "content",
          "name": "formhash"
        }
      ]
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "https://www.t00ls.com/ajax-sign.json",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Referer",
          "value": "https://www.t00ls.com/members-profile-{{uid}}.html"
        }
      ],
      "data": "signsubmit=apply&formhash={{formhash}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": ".+",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
]
