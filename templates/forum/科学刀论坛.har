[
  {
    "request": {
      "method": "GET",
      "url": "https://www.kxdao.net/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "www.kxdao.net"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "自动登录|只需一步，快速开始",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "re": "name=\"formhash\" value=\"(.+)\"",
          "from": "content",
          "name": "formhash"
        }
      ]
    },
    "comment": "登录后首页cookie<br>https://www.kxdao.net/"
  },
  {
    "request": {
      "method": "GET",
      "url": "https://www.kxdao.net/plugin.php?id=dsu_amupper&ppersubmit=true&formhash={{formhash|urlencode}}&infloat=yes&handlekey=dsu_amupper&inajax=1&ajaxtarget=fwin_content_dsu_amupper",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "www.kxdao.net"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Referer",
          "value": "https://www.kxdao.net/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "您当前的访问请求当中含有非法字符，已经被系统拒绝",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "re": "{errorhandle_dsu_amupper\\('(.+)', {}",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
]
