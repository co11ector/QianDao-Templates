[
  {
    "comment": "读取已完成任务页，确认同一账号和固定任务 id=31 是否已经在今天完成；当天已完成时不进入任何写操作",
    "request": {
      "method": "GET",
      "url": "https://game.ali213.net/home.php?mod=task&item=done",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"'])(?=[\\s\\S]*home\\.php\\?mod=task(?:&amp;|&)do=view(?:&amp;|&)id=31)/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "您需要先登录|您需要登录后|请登录后|请输入验证码|验证问答|安全验证|人机验证|请完成验证|captcha|verification|access_(?:env|slide)_challenge",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "account_uid",
          "re": "discuz_uid\\s*=\\s*[\"']([1-9]\\d*)[\"']",
          "from": "content"
        },
        {
          "name": "needs_task",
          "re": "/(?![\\s\\S]*home\\.php\\?mod=task(?:&amp;|&)do=view(?:&amp;|&)id=31[\\s\\S]{0,5000}?完成于\\s*{{date_time(1,0)[0:4]}}-0?{{date_time(1,0)[5:7]|int}}-0?{{date_time(1,0)[8:10]|int}}\\s+\\d{1,2}:\\d{2}:\\d{2}})(?=[\\s\\S]*action=logout)(yes)/",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "仅在固定每日签到任务今天尚未完成时进入申请与签到流程",
    "request": {
      "method": "GET",
      "url": "{% if needs_task == \"yes\" %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
