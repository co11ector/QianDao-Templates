          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=[\"']formhash[\"'][^>]*value=[\"']([A-Za-z0-9]{6,64})[\"']",
          "from": "content"
        }
      ]
    }
  },
