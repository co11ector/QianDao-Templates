  {
    "comment": "读取固定签到主题，确认标题、登录态和动态 formhash",
    "request": {
      "method": "GET",
      "url": "https://game.ali213.net/thread-7098234-1-1.html",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
