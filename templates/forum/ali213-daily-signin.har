  {
    "comment": "在固定签到主题提交一次平台无关的当日日期回复；结果不确定时不重试，由后续本人帖子复核",
    "request": {
      "method": "POST",
      "url": "https://game.ali213.net/forum.php?mod=post&action=reply&fid=46&tid=7098234&extra=page%3D1&replysubmit=yes&infloat=yes&handlekey=fastpost",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://game.ali213.net/thread-7098234-1-1.html"
        },
        {
          "name": "Origin",
          "value": "https://game.ali213.net"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&subject=&message={{ (date_time(1,0)[0:4] ~ '年' ~ (date_time(1,0)[5:7]|int) ~ '月' ~ (date_time(1,0)[8:10]|int) ~ '日签到')|urlencode }}",
