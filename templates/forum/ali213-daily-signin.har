    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"']{{account_uid}}[\"'])(?=[\\s\\S]*(?:每日签到|论坛每日签到))(?:[\\s\\S]*id=[\"']fastpostform[\"'])/i",
          "from": "content"
