          "from": "content"
        },
        {
          "name": "yhm",
          "re": "<p class=\"mb-1\">(.+)</p>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content=登录状态：【{{dl}}】\\r\\n签到状态：【{{msg}}】，用户名：【{{yhm}}】，当前账户余额：【{{zhye}}】"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
