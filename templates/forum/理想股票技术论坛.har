[
  {
    "request": {
      "method": "POST",
      "url": "https://www.55188.com/api/mobile/?module=login&version=6&type=minapp&from=phone",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "content-type",
          "value": "application/json"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip,compress,br,deflate"
        },
        {
          "name": "Host",
          "value": "www.55188.com"
        },
        {
          "name": "Referer",
          "value": "https://servicewechat.com/wxa5071996894675c9/21/page-frame.html"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        }
      ],
      "data": "{\"openid\":\"\",\"account\":\"{{user}}\",\"password\":\"{{pass}}\"}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "uid",
          "re": "uid\":\"(\\d+)\"",
          "from": "content"
        }
      ]
    }
  },
