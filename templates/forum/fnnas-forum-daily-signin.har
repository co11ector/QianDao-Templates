[
  {
    "comment": "使用登录后的 Cookie、同一浏览器 User-Agent 和 Edge 指纹打开飞牛论坛签到页；只识别明确签到成功或今日已签到，普通提示框中的请登录仍会失败关闭",
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/plugin.php?id=zqlj_sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?i)(?=[\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:id=zqlj_sign(?:&amp;|&)sign=[^\"'&]+|今天已经打过卡|今日已签到|已经签到|请勿重复操作))",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|id=[\"']lsform[\"']|name=[\"']username[\"']))|<title>[^<]*(?:Just a moment|Attention Required)[^<]*</title>|id=[\"']challenge-form[\"']|cf-chl-|__cf_chl_",
          "from": "content"
        },
        {
          "re": "(?i)<div[^>]+id=[\"']messagetext[\"'][^>]+class=[\"'][^\"']*alert_(?:error|info)[^\"']*[\"'][^>]*>[\\s\\S]*?(?:请登录|登录后|签到失败|操作失败|未定义操作|非法字符|系统错误|异常请求)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "sign",
          "re": "id=zqlj_sign(?:&amp;|&)sign=([^\"'&]+)",
          "from": "content"
        },
        {
          "name": "needs_submit",
          "re": "id=(zqlj_sign)(?:&amp;|&)sign=[^\"'&]+",
          "from": "content"
        },
        {
          "name": "page_status",
          "re": "(?i)<div[^>]+id=[\"']messagetext[\"'][^>]+class=[\"'][^\"']*alert_info[^\"']*[\"'][^>]*>[\\s\\S]*?<p>([\\s\\S]*?)(?:<script\\b|</p>)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "仅在页面提供签到链接时进入提交步骤",
    "request": {
      "method": "GET",
      "url": "{% if needs_submit %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "提交站点自身的签到链接；只接受明确的成功或重复签到回执",
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/plugin.php?id=zqlj_sign&sign={{sign|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://club.fnnas.com/plugin.php?id=zqlj_sign"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?i)(?:打卡成功|签到成功|打卡完成|今天已经打过卡|今日已签到|已经签到|请勿重复操作)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|id=[\"']lsform[\"']|name=[\"']username[\"']))|<title>[^<]*(?:Just a moment|Attention Required)[^<]*</title>|id=[\"']challenge-form[\"']|cf-chl-|__cf_chl_",
          "from": "content"
        },
        {
          "re": "(?i)<div[^>]+id=[\"']messagetext[\"'][^>]+class=[\"'][^\"']*alert_(?:error|info)[^\"']*[\"'][^>]*>[\\s\\S]*?(?:请登录|登录后|签到失败|操作失败|未定义操作|非法字符|系统错误|异常请求)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "status_message",
          "re": "(?i)<div[^>]+id=[\"']messagetext[\"'][^>]+class=[\"'][^\"']*alert_info[^\"']*[\"'][^>]*>[\\s\\S]*?<p>([\\s\\S]*?)(?:<script\\b|</p>)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "签到链接提交分支结束",
    "request": {
      "method": "GET",
      "url": "{% endif %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "输出飞牛论坛签到结果，不再依赖已失效的打卡统计区块",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=飞牛私有云论坛签到完成：{{ status_message|default(page_status|default('今日已签到', true), true) }}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
