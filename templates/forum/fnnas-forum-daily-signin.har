[
  {
    "comment": "使用登录后的完整 Cookie 与同一浏览器的 User-Agent 打开飞牛论坛签到页，提交网站自身的签到动作并读取签到与积分状态。登录失效、验证码或风控页面会失败关闭。",
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/plugin.php?id=zqlj_sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*id=zqlj_sign(?:&amp;|&)sign=[^\"'&]+)/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录))|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "sign",
          "re": "id=zqlj_sign(?:&amp;|&)sign=([^\"'&]+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交站点签到链接；重复签到也视为成功",
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/plugin.php?id=zqlj_sign&sign={{sign|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://club.fnnas.com/plugin.php?id=zqlj_sign"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "打卡成功|签到成功|您今天已经打过卡了|请勿重复操作",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录))|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        },
        {
          "re": "/<div[^>]+class=[\"'][^\"']*alert_error[^\"']*[\"'][^>]*>[\\s\\S]*?(?:签到失败|登录后|请先登录)/is",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "msg",
          "re": "<div id=\"messagetext\" class=\"alert_info\">[\\s|\\S]*?<p>(.*?)<script type=\"text/javascript\" reload=\"1\">",
          "from": "content"
        },
        {
          "name": "msg1",
          "re": "<div id=\"messagetext\" class=\"alert_error\">[\\s|\\S]*?<p>(.*?)</p>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "回读签到页并确认同一登录会话的连续与累计打卡数据",
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/plugin.php?id=zqlj_sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://club.fnnas.com/plugin.php?id=zqlj_sign"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/最近打卡：.*本月打卡：.*连续打卡：.*累计打卡：/s",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录))|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "zjdk",
          "re": "<li>最近打卡：(.+)</li>",
          "from": "content"
        },
        {
          "name": "bydk",
          "re": "<li>本月打卡：(\\d+)",
          "from": "content"
        },
        {
          "name": "lxdk",
          "re": "<li>连续打卡：(\\d+)",
          "from": "content"
        },
        {
          "name": "ljdk",
          "re": "<li>累计打卡：(\\d+)",
          "from": "content"
        },
        {
          "name": "dkdj",
          "re": "<li>当前打卡等级：(.+)</li>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "读取飞牛币和登录天数",
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/home.php?mod=spacecp&ac=credit&showcredit=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/<em>\\s*飞牛币:\\s*<\\/em>\\s*\\d+.*<em>\\s*登陆天数:\\s*<\\/em>\\s*\\d+/s",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录才能继续本操作|请先登录))|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "fnb",
          "re": "<em> 飞牛币: </em>(\\d+)",
          "from": "content"
        },
        {
          "name": "dlts",
          "re": "<li><em> 登陆天数: </em>(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "html_unescape=false&content=签到状态：【{{msg}} {{msg1}}】\\r\\n飞牛币：【{{fnb}}】，登录天数：【{{dlts}}】\\r\\n最近打卡：【{{zjdk}}】，\\r\\n本月打卡：【{{bydk}}】天，连续打卡：【{{lxdk}}】天，累计打卡：【{{ljdk}}】天，\\r\\n当前打卡等级：【{{dkdj}}】",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
