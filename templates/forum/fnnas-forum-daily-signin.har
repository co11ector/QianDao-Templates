[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 club.fnnas.com 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】打开飞牛私有云论坛固定签到页，先确认登录态和页面状态：\n1. 若页面提供站点生成的签到链接，只提交该固定链接一次；\n2. 若页面显示今天已经打卡，则不重复提交；\n3. 从明确成功或重复签到提示中生成任务日志。不会发帖、回复或操作其他插件。\n\n【成功判定】首次页面必须是已登录状态，并明确出现可签到的 zqlj_sign 链接或今日已签到提示；提交后的回执只能接受打卡成功、签到成功或请勿重复操作等明确业务结果。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 club.fnnas.com 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】模板固定使用 Edge 网络指纹。普通提示框里出现“请登录”、操作失败、非法字符或异常请求时会失败关闭。",
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/plugin.php?id=zqlj_sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?i)(?=[\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:id=zqlj_sign(?:&amp;|&)sign=[^\"'&]+|今天已经打过卡|今日已签到|已经签到|请勿重复操作))",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|id=[\"']lsform[\"']|name=[\"']username[\"']))|<title>[^<]*(?:Just a moment|Attention Required)[^<]*</title>|id=[\"']challenge-form[\"']|cf-chl-|__cf_chl_",
          "from": "content"
        },
        {
          "re": "(?i)<div[^>]+id=[\"']messagetext[\"'][^>]+class=[\"'][^\"']*alert_(?:error|info)[^\"']*[\"'][^>]*>[\\s\\S]*?(?:请登录|登录后|签到失败|操作失败|未定义操作|非法字符|系统错误|异常请求)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "sign",
          "re": "id=zqlj_sign(?:&amp;|&)sign=([^\"'&]+)",
          "from": "content"
        },
        {
          "name": "needs_submit",
          "re": "id=(zqlj_sign)(?:&amp;|&)sign=[^\"'&]+",
          "from": "content"
        },
        {
          "name": "page_status",
          "re": "(?i)<div[^>]+id=[\"']messagetext[\"'][^>]+class=[\"'][^\"']*alert_info[^\"']*[\"'][^>]*>[\\s\\S]*?<p>([\\s\\S]*?)(?:<script\\b|</p>)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "仅在页面提供签到链接时进入提交步骤",
    "request": {
      "method": "GET",
      "url": "{% if needs_submit %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "提交站点自身的签到链接；只接受明确的成功或重复签到回执",
    "request": {
      "method": "GET",
      "url": "https://club.fnnas.com/plugin.php?id=zqlj_sign&sign={{sign|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QianDao-Impersonate",
          "value": "edge"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://club.fnnas.com/plugin.php?id=zqlj_sign"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?i)(?:打卡成功|签到成功|打卡完成|今天已经打过卡|今日已签到|已经签到|请勿重复操作)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|id=[\"']lsform[\"']|name=[\"']username[\"']))|<title>[^<]*(?:Just a moment|Attention Required)[^<]*</title>|id=[\"']challenge-form[\"']|cf-chl-|__cf_chl_",
          "from": "content"
        },
        {
          "re": "(?i)<div[^>]+id=[\"']messagetext[\"'][^>]+class=[\"'][^\"']*alert_(?:error|info)[^\"']*[\"'][^>]*>[\\s\\S]*?(?:请登录|登录后|签到失败|操作失败|未定义操作|非法字符|系统错误|异常请求)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "status_message",
          "re": "(?i)<div[^>]+id=[\"']messagetext[\"'][^>]+class=[\"'][^\"']*alert_info[^\"']*[\"'][^>]*>[\\s\\S]*?<p>([\\s\\S]*?)(?:<script\\b|</p>)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "签到链接提交分支结束",
    "request": {
      "method": "GET",
      "url": "{% endif %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "输出飞牛论坛签到结果，不再依赖已失效的打卡统计区块",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=飞牛私有云论坛签到完成：{{ status_message|default(page_status|default('今日已签到', true), true) }}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
