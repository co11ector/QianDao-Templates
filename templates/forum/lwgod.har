[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 www.lwgod.org 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】只读访问 Discuz X3 论坛首页和积分页，不执行任务、不发帖、不改账号设置：\n1. 打开首页触发“每天登录”奖励；\n2. 读取龙币、龙力和积分摘要；\n3. 打开积分规则明细，确认“每天登录”记录、奖励值和最近发放时间；\n4. 把账号、UID 和上述结果写入任务日志。\n\n【成功判定】首页必须出现带 formhash 的退出登录链接，积分页能读到龙币/龙力/积分，积分规则页存在“每天登录”行并包含可验证的最近奖励时间。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 www.lwgod.org 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】站点对非浏览器指纹较敏感，模板固定使用 Chrome TLS/HTTP2 指纹；应用仍执行严格 HTTPS 证书校验。",
    "request": {
      "method": "GET",
      "url": "https://www.lwgod.org/forum.php",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=[A-Za-z0-9]+",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|name=[\"']username[\"']|id=[\"']lsform[\"']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "uid",
          "re": "space-uid-([1-9]\\d*)\\.html",
          "from": "content"
        },
        {
          "name": "username",
          "re": "/class=[\"']vwmy[\"'][^>]*>.*?<a[^>]*>([^<]+)<\\/a>/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "读取龙币、龙力与积分摘要",
    "request": {
      "method": "GET",
      "url": "https://www.lwgod.org/home.php?mod=spacecp&ac=credit&showcredit=1",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://www.lwgod.org/forum.php"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=logout(?:&amp;|&)formhash=[A-Za-z0-9]+",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|name=[\"']username[\"']|id=[\"']lsform[\"']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "dragon_coin",
          "re": "/<em>\\s*龙币:\\s*<\\/em>\\s*([^<&\\r\\n]+)/s",
          "from": "content"
        },
        {
          "name": "dragon_power",
          "re": "/<em>\\s*龙力:\\s*<\\/em>\\s*([^<&\\r\\n]+)/s",
          "from": "content"
        },
        {
          "name": "points",
          "re": "/<em>\\s*积分:\\s*<\\/em>\\s*([^<&\\r\\n]+)/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "核对「每天登录」奖励记录与最近发放时间",
    "request": {
      "method": "GET",
      "url": "https://www.lwgod.org/home.php?mod=spacecp&ac=credit&op=log&suboperation=creditrulelog",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-QD-Impersonate",
          "value": "chrome"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://www.lwgod.org/home.php?mod=spacecp&ac=credit&showcredit=1"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "rid=15[^>]*>每天登录<\\/a>",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|name=[\"']username[\"']|id=[\"']lsform[\"']",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "daily_coin",
          "re": "/rid=15[^>]*>每天登录<\\/a>\\s*<\\/td>\\s*<td>\\s*\\d+\\s*<\\/td>\\s*<td>\\s*\\d+\\s*<\\/td>\\s*<td>\\s*(-?\\d+)\\s*<\\/td>/s",
          "from": "content"
        },
        {
          "name": "daily_power",
          "re": "/rid=15[^>]*>每天登录<\\/a>\\s*<\\/td>\\s*<td>\\s*\\d+\\s*<\\/td>\\s*<td>\\s*\\d+\\s*<\\/td>\\s*<td>\\s*-?\\d+\\s*<\\/td>\\s*<td>\\s*(-?\\d+)\\s*<\\/td>/s",
          "from": "content"
        },
        {
          "name": "last_reward",
          "re": "/rid=15[^>]*>每天登录<\\/a>.*?(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2})/s",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成任务日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "content=梦幻天堂·龙网每日登录奖励成功，账号: {{username|default('未知')|urlencode}}，UID: {{uid|default('未知')|urlencode}}，龙币: {{dragon_coin|default('未知')|urlencode}}，龙力: {{dragon_power|default('未知')|urlencode}}，积分: {{points|default('未知')|urlencode}}，每日奖励: 龙币+{{daily_coin|default('未知')|urlencode}}、龙力+{{daily_power|default('未知')|urlencode}}，最近奖励时间: {{last_reward|default('未知')|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
