[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 www.hdsky.net 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】打开固定 DSU 签到页，读取动态 formhash、账号 UID 和今日状态：已签到时直接跳过；未签到时只提交一次固定表单；最后重新打开签到页核对本人今日签到状态。不会浏览种子或修改账号设置。\n\n【成功判定】首次页面必须为已登录并提取到 formhash；最终页面必须仍为同一 account_uid，并明确显示今日已签到。提交回执中的明确错误会立即失败。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 www.hdsky.net 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】不在允许签到时间、非法字符、未定义操作、Cloudflare 或登录失效都会失败关闭，不会重试提交。",
    "request": {
      "method": "GET",
      "url": "https://www.hdsky.net/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*name=[\"']formhash[\"'][^>]*value=[\"'][^\"']+)/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|id=[\"']lsform[\"']|name=[\"']username[\"']))|<title>[^<]*(?:Just a moment|Attention Required)[^<]*</title>|id=[\"']challenge-form[\"']|cf-chl-|__cf_chl_",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=[\"']formhash[\"'][^>]*value=[\"']([^\"']+)",
          "from": "content"
        },
        {
          "name": "account_uid",
          "re": "discuz_uid\\s*=\\s*[\"']([1-9]\\d*)[\"']",
          "from": "content"
        },
        {
          "name": "signed_today",
          "re": "(?=[\\s\\S]*今日已签到)(signed)",
          "from": "content"
        },
        {
          "name": "needs_submit",
          "re": "id=[\"'](qiandao)[\"']",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "仅在当前账号今日尚未签到时提交一次固定 DSU 表单",
    "request": {
      "method": "GET",
      "url": "{% if needs_submit %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "提交 HDSky 固定签到表单；HTTP 回执只用于拒绝明确错误，最终结果由刷新复核",
    "request": {
      "method": "POST",
      "url": "https://www.hdsky.net/plugin.php?id=dsu_paulsign:sign&operation=qiandao&infloat=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://www.hdsky.net/plugin.php?id=dsu_paulsign:sign"
        },
        {
          "name": "Origin",
          "value": "https://www.hdsky.net"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&qdxq=kx&qdmode=2&todaysay=&fastreply=0",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "签到成功|已经签到|今日已签到|已经签过",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)(?:非法字符|未定义操作|不在允许签到时间|签到时间还未开始)|\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|id=[\"']lsform[\"']|name=[\"']username[\"']))|<title>[^<]*(?:Just a moment|Attention Required)[^<]*</title>|id=[\"']challenge-form[\"']|cf-chl-|__cf_chl_",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "签到提交条件结束",
    "request": {
      "method": "GET",
      "url": "{% endif %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "刷新固定签到页，确认同一账号且上次签到时间就是今天",
    "request": {
      "method": "GET",
      "url": "https://www.hdsky.net/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"']{{account_uid}}[\"'])(?=[\\s\\S]*今日已签到)/",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?i)\\A(?![\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*(?:member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|id=[\"']lsform[\"']|name=[\"']username[\"']))|<title>[^<]*(?:Just a moment|Attention Required)[^<]*</title>|id=[\"']challenge-form[\"']|cf-chl-|__cf_chl_",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "(今日已签到)",
          "from": "content"
        }
      ]
    }
  }
]
