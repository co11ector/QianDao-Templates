[
  {
    "request": {
      "method": "GET",
      "url": "https://{{domain}}/attendance.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "avccept",
          "value": "keep-alive"
        },
        {
          "name": "Referer",
          "value": "https://{{domain}}/index.php"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "document"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "navigate"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-User",
          "value": "?1"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "sec-ch-ua",
          "value": "\\\"Not(A:Brand\\\";v=\\\"99\\\", \\\"Google Chrome\\\";v=\\\"133\\\", \\\"Chromium\\\";v=\\\"133\\\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\\\"Windows\\\""
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "关闭维护",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "recheck_cnt",
          "re": "第[\\s\\S]+今日签到排名：<b>\\d+</b> / <b>\\d+</b>",
          "from": "content"
        },
        {
          "name": "traffic",
          "re": "分享率[:][\\s\\S]+当前活动",
          "from": "content"
        }
      ]
    },
    "comment": "f12获取cookie，填入pt站点的域名，参考了作者 @IITII 制作的通用pt签到保号脚本，在原作者基础上删去了部分请求头并添加了一些新请求头，用来签到雨和星陨阁pt站点，但不清楚改动后的请求头后还是否能用在他站点签到，自己只测试试验了部分小的站点是可以，和原作者一样只原版 NexusPHP。<br>不知道改动是否会影响其他站点使用，就提交了新的模板，如果用不了就请使用IITII制作的har。"
  },
  {
    "comment": "字符串替换",
    "request": {
      "method": "POST",
      "url": "api://util/string/replace",
      "headers": [],
      "data": "r=text&p=当前活动&t=&s={{domain}}: {{traffic | striptags}} {{regex_replace(recheck_cnt | striptags, \"点击[\\s\\S]+目前\", \"\")}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"OK\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": ".*",
          "from": "content"
        }
      ]
    }
  }
]
