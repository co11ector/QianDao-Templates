[
  {
    "request": {
      "method": "POST",
      "url": "https://ourbits.club/takelogin.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "ourbits.club"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Cache-Control",
          "value": "max-age=0"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Origin",
          "value": "https://ourbits.club"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "navigate"
        },
        {
          "name": "Sec-Fetch-User",
          "value": "?1"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "document"
        },
        {
          "name": "Referer",
          "value": "https://ourbits.club/login.php"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "username={{user|urlencode}}&password={{pass|urlencode}}&2fa_code=&trackerssl=yes",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "302",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "https://ourbits.club/attendance.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":method",
          "value": "GET"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": ":path",
          "value": "/attendance.php"
        },
        {
          "name": "upgrade-insecure-requests",
          "value": "1"
        },
        {
          "name": "dnt",
          "value": "1"
        },
        {
          "name": "accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "sec-fetch-site",
          "value": "same-origin"
        },
        {
          "name": "sec-fetch-mode",
          "value": "navigate"
        },
        {
          "name": "sec-fetch-user",
          "value": "?1"
        },
        {
          "name": "sec-fetch-dest",
          "value": "document"
        },
        {
          "name": "referer",
          "value": "ourbits.clubfaq.php"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-US;q=0.7"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "签到已得\\w+",
          "from": "content",
          "name": "__log__"
        },
        {
          "re": "魔力值 </.+a>]:( \\w+?.+.+签到已得\\w+.)",
          "from": "content",
          "name": "__log__"
        },
        {
          "re": "签到已得\\w+",
          "from": "content",
          "name": "zt1"
        },
        {
          "re": "魔力值 </.+a>]: (\\w+?.+).+签到",
          "from": "content",
          "name": "zt2"
        }
      ]
    }
  }
]
