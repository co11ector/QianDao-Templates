[
  {
    "comment": "",
    "request": {
      "method": "GET",
      "url": "http://service.5sing.kugou.com/user/sign?jsoncallback=jq5",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        },
        {
          "name": "Referer",
          "value": "http://5sing.kugou.com/"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": ".*\\\\u8bf7\\\\u5148\\\\u767b\\\\u9646.*",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "re": "\"(.+)\"",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
]
