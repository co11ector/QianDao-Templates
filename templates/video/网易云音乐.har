[
  {
    "request": {
      "method": "GET",
      "url": "http://music.163.com/api/point/dailyTask?type=0",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "DNT",
          "value": "1"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, sdch"
        },
        {
          "name": "Accept-Language",
          "value": "en,zh-CN;q=0.8,zh;q=0.6"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Referer",
          "value": "http://music.163.com/discover"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "重复签到",
          "from": "content"
        },
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"code\":301",
          "from": "content"
        }
      ],
      "extract_variables": []
    },
    "comment": "网易云音乐 电脑 or 手机 cookie<br>https://music.163.com/"
  },
