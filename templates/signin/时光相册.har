[
  {
    "request": {
      "method": "POST",
      "url": "https://web.everphoto.cn/api/auth",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "x-bigint-support",
          "value": "false"
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        {
          "name": "accept",
          "value": "*/*"
        },
        {
          "name": "origin",
          "value": "https://web.everphoto.cn"
        },
        {
          "name": "referer",
          "value": "https://web.everphoto.cn/"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ],
      "data": "mobile={{phone}}&password={{password}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "token",
          "re": "\"token\": \"(.+?)\"",
          "from": "content"
        }
      ]
    },
    "comment": "phone:账号<br>password:密码<br>手机号密码 请抓登陆包查看 手机号里包括区号 86啥的 密码为加密后的密码<br>https://www.everphoto.cn/"
  },
  {
    "comment": "签到",
    "request": {
      "method": "POST",
      "url": "https://api.everphoto.cn/users/self/checkin/v2",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "x-bigint-support",
          "value": "false"
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        {
          "name": "accept",
          "value": "*/*"
        },
        {
          "name": "origin",
          "value": "https://web.everphoto.cn"
        },
        {
          "name": "referer",
          "value": "https://web.everphoto.cn/"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "authorization",
          "value": "Bearer {{token}}"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "continuity",
          "re": "\"continuity\": (.+?),",
          "from": "content"
        },
        {
          "name": "total_reward",
          "re": "\"total_reward\": (.+?),",
          "from": "content"
        },
        {
          "name": "tomorrow_reward",
          "re": "\"tomorrow_reward\": (.+?),",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成日志",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=&p=&s=%E5%B7%B2%E8%BF%9E%E7%BB%AD%E7%AD%BE%E5%88%B0{{continuity|urlencode}}%20%E5%A4%A9%EF%BC%8C%E7%B4%AF%E8%AE%A1%E8%8E%B7%E5%BE%97{{divide(total_reward,1024*1024)|urlencode|urlencode}}MB%E7%A9%BA%E9%97%B4%EF%BC%8C%E6%98%8E%E5%A4%A9%E5%B0%86%E8%8E%B7%E5%BE%97{{divide(tomorrow_reward,1024*1024)|urlencode|urlencode}}MB%E7%A9%BA%E9%97%B4%E3%80%82",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": ".+",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
]
