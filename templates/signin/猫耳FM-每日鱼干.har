[
  {
    "request": {
      "method": "GET",
      "url": "https://www.missevan.com/member/getcatears?gtype=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Accept",
          "value": "application/json, text/javascript, */*; q=0.01"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Referer",
          "value": "https://www.missevan.com/mperson/task"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"success\":false",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "re": "\"message\":\"(.+)\",\"type",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
]
