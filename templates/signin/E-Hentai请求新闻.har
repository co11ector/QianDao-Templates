[
  {
    "comment": "Fetch news page",
    "request": {
      "method": "GET",
      "url": "https://e-hentai.org/news.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "accept\n",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/jxl,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "dnt",
          "value": "1"
        },
        {
          "name": "priority",
          "value": "u=0, i"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Not?A_Brand\";v=\"99\", \"Chromium\";v=\"130\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Linux\""
        },
        {
          "name": "sec-fetch-dest",
          "value": "document"
        },
        {
          "name": "sec-fetch-mode",
          "value": "navigate"
        },
        {
          "name": "sec-fetch-site\n",
          "value": "none"
        },
        {
          "name": "sec-fetch-user",
          "value": "?1"
        },
        {
          "name": "sec-gpc",
          "value": "1"
        },
        {
          "name": "upgrade-insecure-requests",
          "value": "1"
        },
        {
          "name": "referer",
          "value": "https://e-hentai.org/"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "event_content",
          "re": "<div id=\"eventpane\" .+?>(.+)<\\/div><div id=\"nb\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Remove HTML tags",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content={{event_content|striptags}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "You have encountered a monster!",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "event_result",
          "re": "\"转换后\": \"(.+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Print log",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content=Result: {{event_result}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.+)\"",
          "from": "content"
        }
      ]
    }
  }
]
