        },
        {
          "name": "Host",
          "value": "www.3gbizhi.com"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Chromium\";v=\"122\", \"Not(A:Brand\";v=\"24\", \"Google Chrome\";v=\"122\""
        },
        {
          "name": "Accept",
          "value": "application/json, text/javascript, */*; q=0.01"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Origin",
          "value": "https://www.3gbizhi.com"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Referer",
          "value": "https://www.3gbizhi.com/user/index"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "msg",
          "re": "\"msg\":\"(.*?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "会员中心",
    "request": {
      "method": "GET",
      "url": "https://www.3gbizhi.com/api/user/getUserSignin",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "www.3gbizhi.com"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Chromium\";v=\"122\", \"Not(A:Brand\";v=\"24\", \"Google Chrome\";v=\"122\""
        },
        {
          "name": "Accept",
          "value": "application/json, text/javascript, */*; q=0.01"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Referer",
          "value": "https://www.3gbizhi.com/user/index"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "byqd",
          "re": "\"signed_count\":(\\d+)",
          "from": "content"
        },
        {
          "name": "bzqd",
          "re": "\"week_signin_days\":(\\d+)",
          "from": "content"
        },
        {
          "name": "lxqd",
          "re": "\"continuous_days\":(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "积分",
    "request": {
      "method": "GET",
      "url": "https://www.3gbizhi.com/user/{{name}}/mycollection",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Referer",
          "value": "https://www.3gbizhi.com/"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "请登录后再操作",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "jifen",
          "re": "\"精确积分：(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content=登录状态：{{dlzt}}。\\r\\n签到状态：{{msg}}。\\r\\n积分：{{jifen}}，连续签到：{{lxqd}}天，本周连续签到：{{bzqd}}天，本月连续签到：{{byqd}}天。"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
