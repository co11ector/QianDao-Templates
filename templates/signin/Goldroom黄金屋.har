[
  {
    "comment": "首页",
    "request": {
      "method": "GET",
      "url": "http://goldroom.top/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "account",
          "re": "档案\\(@(.+?)\\)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "积分页",
    "request": {
      "method": "GET",
      "url": "http://goldroom.top/user/profile/{{account}}/goldpoints/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "lv",
          "re": "会员等级: <span class=\"\">(.+?)<",
          "from": "content"
        },
        {
          "name": "jrxz",
          "re": "今日剩余下载次数: (\\d+)<",
          "from": "content"
        },
        {
          "name": "jrts",
          "re": "今日剩余推送次数: (\\d+)<",
          "from": "content"
        },
        {
          "name": "ed",
          "re": "剩余额度: (\\d+)<",
          "from": "content"
        },
        {
          "name": "scdl",
          "re": "上次登录: (.+?)<",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "日志",
    "request": {
      "method": "GET",
