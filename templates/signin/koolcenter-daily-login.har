[
  {
    "comment": "使用 Cookie 与同一浏览器 User-Agent 访问酷友社首页，确认未跳转到单点登录且不是安全验证页；全程只读",
    "request": {
      "method": "GET",
      "url": "https://www.koolcenter.com/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "酷友社|koolcenter",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "Just a moment|Checking your browser|Verify you are human|人机验证|安全验证|challenge-form|cf-challenge|cdn-cgi",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "读取 Discourse 当前会话接口，要求返回当前登录用户",
    "request": {
      "method": "GET",
      "url": "https://www.koolcenter.com/session/current.json",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "application/json"
        },
        {
          "name": "Referer",
          "value": "https://www.koolcenter.com/"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"current_user\"\\s*:\\s*\\{[^}]*\"username\"\\s*:\\s*\"[^\"]+\"",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"current_user\"\\s*:\\s*null|Not Found|未登录|请登录|Just a moment|人机验证|安全验证",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "trust_level",
          "re": "\"trust_level\"\\s*:\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "访问最新话题页，记录每日登录访问",
    "request": {
      "method": "GET",
      "url": "https://www.koolcenter.com/latest",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://www.koolcenter.com/"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "最新|latest|topic",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "Just a moment|Checking your browser|Verify you are human|人机验证|安全验证|challenge-form|cf-challenge|cdn-cgi",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "再次读取当前会话接口，防止半失效 Cookie 被误报为成功",
    "request": {
      "method": "GET",
      "url": "https://www.koolcenter.com/session/current.json",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "application/json"
        },
        {
          "name": "Referer",
          "value": "https://www.koolcenter.com/latest"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"current_user\"\\s*:\\s*\\{[^}]*\"username\"\\s*:\\s*\"[^\"]+\"",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"current_user\"\\s*:\\s*null|Not Found|未登录|请登录|Just a moment|人机验证|安全验证",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  }
]
