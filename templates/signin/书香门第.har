[
  {
    "comment": "登录",
    "request": {
      "method": "POST",
      "url": "http://www.txtnovel.top/member.php?mod=logging&action=login&loginsubmit=yes&loginhash=&mobile=2",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "accept",
          "value": "*/*"
        },
        {
          "name": "referer",
          "value": "http://www.txtnovel.top/member.php?mod=logging&action=login&mobile=2"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Host",
          "value": "www.txtnovel.top"
        }
      ],
      "data": "formhash=&referer=http%253A%252F%252Fwww.txtnovel.top%252F&fastloginfield=username&cookietime=2592000&username={{account|urlencode}}&password={{password|urlencode}}&questionid=0&answer=&submit=true",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "获取formhash",
    "request": {
      "method": "GET",
      "url": "http://www.txtnovel.top/plugin.php?id=dsu_paulsign%3Asign&mobile=yes",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "accept",
          "value": "*/*"
        },
        {
          "name": "referer",
          "value": "http://www.txtnovel.top/member.php?mod=logging&action=login&mobile=2"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Host",
          "value": "www.txtnovel.top"
        }
      ],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "formhash.*\"(.+?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "签到",
    "request": {
      "method": "POST",
      "url": "http://www.txtnovel.top/plugin.php?id=dsu_paulsign%3Asign&operation=qiandao&infloat=0&inajax=0&mobile=yes",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "accept",
          "value": "*/*"
        },
        {
          "name": "referer",
          "value": "http://www.txtnovel.top/member.php?mod=logging&action=login&mobile=2"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "Host",
          "value": "www.txtnovel.top"
        }
      ],
      "data": "formhash={{formhash|urlencode}}&qdxq=kx",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "网站维护中",
          "from": "content"
        },
        {
          "re": "未定义操作",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "(.*?)<a href.*?\\]<\\/a><\\/div>",
          "from": "content"
        }
      ]
    }
  }
]
