[
  {
    "comment": "获取TOKEN",
    "request": {
      "method": "POST",
      "url": "https://zhutix.com/wp-json/b2/v1/getRecaptcha",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Origin",
          "value": "https://zhutix.com"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://zhutix.com/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "number=4&width=186&height=50",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "\"token\":\"(.+)\",",
          "from": "content",
          "name": "token"
        }
      ]
    }
  },
  {
    "comment": "登录",
    "request": {
      "method": "POST",
      "url": "https://zhutix.com/wp-json/jwt-auth/v1/token",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Origin",
          "value": "https://zhutix.com"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://zhutix.com/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "nickname=&username={{user|urlencode}}&password={{pass|urlencode}}&code=&img_code=&invitation_code=&token={{token}}&smsToken=&luoToken=&confirmPassword=&loginType=",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "user_display_name\":\"(.+)\",\"na",
          "from": "content",
          "name": "name"
        },
        {
          "re": "\"token\":\"(.+)\",\"user_displ",
          "from": "content",
          "name": "Authorization"
        }
      ]
    }
  },
  {
    "comment": "刷新Mission",
