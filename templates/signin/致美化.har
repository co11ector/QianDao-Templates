        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Origin",
          "value": "https://zhutix.com"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{Authorization}}"
        },
        {
          "name": "Referer",
          "value": "https://zhutix.com/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "(\"credit\":\"(\\d+)\"|^\"(\\d+)\"$)",
          "from": "content",
          "name": "jf"
        }
      ]
    }
  },
  {
    "comment": "用户信息",
    "request": {
      "method": "POST",
      "url": "https://zhutix.com/wp-json/b2/v1/getUserInfo",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Origin",
          "value": "https://zhutix.com"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://zhutix.com/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{Authorization}}"
        }
      ],
      "data": "ref=null",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "credit",
          "re": "\"credit\":\"(\\d+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "字符串替换",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=%C2%A0&p=%C2%A0&s=%E6%81%AD%E5%96%9C%EF%BC%81%E6%82%A8%E4%BB%8A%E5%A4%A9%E8%8E%B7%E5%BE%97%E4%BA%86%E3%80%90{{jf|urlencode}}%E3%80%91%E7%A7%AF%E5%88%86%20%7C%20%E7%94%A8%E6%88%B7%E5%90%8D%3A%E3%80%90{{unicode(name)|urlencode}}%20%E3%80%91%2C%E6%80%BB%E7%A7%AF%E5%88%86%EF%BC%9A%E3%80%90{{credit|urlencode}}%E3%80%91",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": ".+",
          "from": "content"
        }
      ]
    }
  }
]
