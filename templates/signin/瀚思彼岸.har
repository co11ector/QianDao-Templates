[
  {
    "comment": "每日登录",
    "request": {
      "method": "GET",
      "url": "https://bbs.hassbian.com/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "bbs.hassbian.com"
        },
        {
          "name": "accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        },
        {
          "name": "cache-control",
          "value": "no-cache"
        },
        {
          "name": "referer",
          "value": "https://bbs.hassbian.com/home.php?mod=spacecp&ac=credit&showcredit=1"
        },
        {
          "name": "upgrade-insecure-requests",
          "value": "1"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "获取积分",
    "request": {
      "method": "GET",
      "url": "https://bbs.hassbian.com/home.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":authority",
          "value": "bbs.hassbian.com"
        },
        {
          "name": "accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        },
        {
          "name": "referer",
          "value": "https://bbs.hassbian.com/home.php?mod=spacecp&ac=credit&showcredit=1"
        },
        {
          "name": "upgrade-insecure-requests",
          "value": "1"
        },
        {
          "name": "DNT",
          "value": "1"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "log_value",
          "re": "<em>金钱</em>(\\d+)\\s*",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [],
      "data": "content=金钱: {{log_value}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
