[
  {
    "request": {
      "method": "POST",
      "url": "https://api.aclink.top/user/login",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":method",
          "value": "POST"
        },
        {
          "name": ":path",
          "value": "/user/login"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": "accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "content-type",
          "value": "application/json"
        },
        {
          "name": "origin",
          "value": "https://www.aclink.top"
        },
        {
          "name": "priority",
          "value": "u=1, i"
        },
        {
          "name": "referer",
          "value": "https://www.aclink.top/"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Not/A)Brand\";v=\"8\", \"Chromium\";v=\"126\", \"Google Chrome\";v=\"126\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "sec-fetch-dest",
          "value": "empty"
        },
        {
          "name": "sec-fetch-mode",
          "value": "cors"
        },
        {
          "name": "sec-fetch-site",
          "value": "same-site"
        }
      ],
      "data": "{\"Email\":\"{{username}}\",\"Password\":\"{{password}}\"}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "用户不存在",
          "from": "content"
        },
        {
          "re": "密码错误",
          "from": "content"
        }
      ],
      "extract_variables": []
    },
    "comment": "每日签到, 领取积分<br>不限速下载以及下载资源<br><br>username 账号<br>password 密码"
  },
  {
    "request": {
      "method": "GET",
      "url": "https://api.aclink.top/user/qd",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":method",
          "value": "GET"
        },
        {
          "name": ":path",
          "value": "/user/qd"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": "accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "origin",
          "value": "https://www.aclink.top"
        },
        {
          "name": "priority",
          "value": "u=1, i"
        },
        {
          "name": "referer",
          "value": "https://www.aclink.top/"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Not/A)Brand\";v=\"8\", \"Chromium\";v=\"126\", \"Google Chrome\";v=\"126\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "sec-fetch-dest",
          "value": "empty"
        },
        {
          "name": "sec-fetch-mode",
          "value": "cors"
        },
        {
          "name": "sec-fetch-site",
          "value": "same-site"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "msg",
          "re": "Msg\":\"(\\s+||\\S+)\"(,\"|})",
          "from": "content"
        },
        {
          "name": "time",
          "re": "QDTime\":\"(\\S+)",
          "from": "content"
        },
        {
          "name": "jf",
          "re": "\"Sou\":(\\S+)}",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content=【状态】:{{msg}} 【签到时间】:{{time}}【积分】:{{jf}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
