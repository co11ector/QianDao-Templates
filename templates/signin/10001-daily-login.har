[
  {
    "comment": "使用 Cookie 与同一浏览器 User-Agent 访问高清影视之家首页，确认退出链接和当前账号 UID；全程只读",
    "request": {
      "method": "GET",
      "url": "https://10001.baidubaidu.win/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"'])/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "安全验证|人机验证|请完成[^\\n]{0,20}验证|拖动[^\\n]{0,20}滑块|验证码",
          "from": "content"
        },
        {
          "re": "请在登[陆录]账号后继续访问网站|用户登录页面|请先登录|member\\.php\\?mod=logging(?:&amp;|&)action=login",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "account_uid",
          "re": "discuz_uid\\s*=\\s*[\"']([1-9]\\d*)[\"']",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "读取当前账号的积分规则记录，只接受唯一“每天登录”行及其可验证时间；今日已记录时不进入任务中心",
    "request": {
      "method": "GET",
      "url": "https://10001.baidubaidu.win/home.php?mod=spacecp&ac=credit&op=log&suboperation=creditrulelog",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://10001.baidubaidu.win/"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"']{{account_uid}}[\"'])(?=[\\s\\S]*<tr[^>]*>(?:(?!<\\/tr>)[\\s\\S])*每天登录(?:(?!<\\/tr>)[\\s\\S])*\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2})/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "安全验证|人机验证|请完成[^\\n]{0,20}验证|拖动[^\\n]{0,20}滑块|验证码",
          "from": "content"
        },
        {
          "re": "请在登[陆录]账号后继续访问网站|用户登录页面|请先登录|member\\.php\\?mod=logging(?:&amp;|&)action=login",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "reward_date",
          "re": "/(?=[\\s\\S]*每天登录)[\\s\\S]*?(\\d{4}-\\d{2}-\\d{2})/i",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "把奖励日期中与当前上海日期相同的值替换为内部标记 today_ok；只用于决定是否需要红包兜底",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=today_ok&p={{1|date_time(1,0)}}&s={{reward_date|urlencode}}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": ".+",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "reward_state",
          "re": "(.*)",
          "from": "content"
        },
        {
          "name": "reward_today",
          "re": "(today_ok)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "把仍为非 today_ok 的奖励日期替换为内部标记 pending；页面缺失日期时不会进入红包分支",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=pending&p=%5E%28%3F%21today_ok%24%29.*%24&s={{reward_state|urlencode}}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": ".+",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "needs_redpacket",
          "re": "(pending)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "仅在“每天登录”奖励今天尚未推进时进入固定红包任务分支",
    "request": {
      "method": "GET",
      "url": "{% if needs_redpacket == \"pending\" %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "读取当前账号的已完成任务页，确认每日红包是否已经领取；已领取时不再申请",
    "request": {
      "method": "GET",
      "url": "https://10001.baidubaidu.win/home.php?mod=task&item=done",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://10001.baidubaidu.win/home.php?mod=spacecp&ac=credit&op=log&suboperation=creditrulelog"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*action=logout)(?=[\\s\\S]*discuz_uid\\s*=\\s*[\"']{{account_uid}}[\"'])/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "安全验证|人机验证|请完成[^\\n]{0,20}验证|拖动[^\\n]{0,20}滑块|验证码",
          "from": "content"
        },
        {
          "re": "请在登[陆录]账号后继续访问网站|用户登录页面|请先登录|member\\.php\\?mod=logging(?:&amp;|&)action=login",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "redpacket_ok",
          "re": "/(?=[\\s\\S]*action=logout)[\\s\\S]*?(【每日任务】论坛每日红包)/i",
          "from": "content"
        },
        {
          "name": "redpacket_pending",
          "re": "/(?=[\\s\\S]*action=logout)(?![\\s\\S]*【每日任务】论坛每日红包)[\\s\\S]*?(暂无任务)/i",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "仅在已完成任务列表没有今日红包时执行一次固定任务 id=12 的申请",
    "request": {
      "method": "GET",
      "url": "{% if redpacket_pending == \"暂无任务\" %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "申请高清影视之家固定每日红包任务 id=12；只接受站点明确的申请成功或本期已申请结果，不自动重试",
    "request": {
      "method": "GET",
      "url": "https://10001.baidubaidu.win/home.php?mod=task&do=apply&id=12",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://10001.baidubaidu.win/home.php?mod=task&item=done"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "任务申请成功|申请成功|恭喜您申请成功|已申请|本期您已申请过此任务.*?下期再来",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "安全验证|人机验证|请完成[^\\n]{0,20}验证|拖动[^\\n]{0,20}滑块|验证码",
          "from": "content"
        },
        {
          "re": "请在登[陆录]账号后继续访问网站|用户登录页面|请先登录|member\\.php\\?mod=logging(?:&amp;|&)action=login",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "redpacket_ok",
          "re": "(任务申请成功|申请成功|恭喜您申请成功|已申请|本期您已申请过此任务.*?下期再来)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "固定红包任务申请条件结束",
    "request": {
      "method": "GET",
      "url": "{% endif %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "每日登录奖励分支结束",
    "request": {
      "method": "GET",
      "url": "{% endif %}",
      "headers": [],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "输出可验证的高清影视之家每日奖励结果；两个状态都缺失时拒绝判定成功",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "content=高清影视之家{{ reward_today|default('')|replace('today_ok', '今日登录已确认') }}{{ redpacket_ok|default('') }}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "今日登录已确认|【每日任务】论坛每日红包|任务申请成功|申请成功|恭喜您申请成功|已申请|本期您已申请过此任务",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
