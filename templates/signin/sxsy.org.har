[
  {
    "request": {
      "method": "GET",
      "url": "https://sxsy.org/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "d",
          "re": "latestDomain\\s*:\\s*\\\"(.+)\\\"",
          "from": "content"
        }
      ]
    },
    "comment": "Unicode转换"
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "content=https://{{d}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "d",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "{{d}}",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "301",
          "from": "status"
        },
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "302",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "{{d}}/member.php?mod=logging&action=login&loginsubmit=yes&lssubmit=yes&inajax=1",
      "headers": [],
      "data": "username={{username}}&password={{password}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "auth",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "auth",
          "re": "auth=(.+)&referer",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "{{d}}/member.php?mod=logging&action=login&inajax=1",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "登录",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "idhash",
          "re": "seccode_(\\w+)\"",
          "from": "content"
        },
        {
          "name": "s",
          "re": "",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "While 循环开始",
    "request": {
      "method": "GET",
      "url": "{% while int(loop_index0) < 66 and s == '' %}",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "{{d}}/misc.php?mod=seccode&idhash={{idhash|urlencode}}",
      "headers": [
        {
          "name": "Referer",
          "value": "{{d}}"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "v",
          "re": ".+",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "OCR识别",
    "request": {
      "method": "POST",
      "url": "api://util/dddd/ocr",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "data": "{\"img\":\"{{v}}\",\"imgurl\":\"\",\"old\":\"False\",\"extra_onnx_name\":\"\"}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "v",
          "re": "\"Result\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "{{d}}/member.php?mod=logging&action=login&loginsubmit=yes&handlekey=login&inajax=1",
      "headers": [],
      "data": "auth={{auth}}&seccodehash={{idhash}}&seccodeverify={{v}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "欢迎",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "s",
          "re": "succeed",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "While 循环结束",
    "request": {
      "method": "GET",
      "url": "{% endwhile %}",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": []
    }
  },
