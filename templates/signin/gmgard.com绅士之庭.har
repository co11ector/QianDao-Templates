[
  {
    "request": {
      "method": "POST",
      "url": "https://gmgard.com/api/PunchIn/Do",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":method",
          "value": "POST"
        },
        {
          "name": ":authority",
          "value": "gmgard.com"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": ":path",
          "value": "/api/PunchIn/Do"
        },
        {
          "name": "accept",
          "value": "*/*"
        },
        {
          "name": "x-requested-with",
          "value": "XMLHttpRequest"
        },
        {
          "name": "content-type",
          "value": "application/json"
        },
        {
          "name": "origin",
          "value": "https://gmgard.com"
        },
        {
          "name": "sec-fetch-site",
          "value": "same-origin"
        },
        {
          "name": "sec-fetch-mode",
          "value": "cors"
        },
        {
          "name": "sec-fetch-dest",
          "value": "empty"
        },
        {
          "name": "referer",
          "value": "https://gmgard.com/"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "{}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": []
    },
    "comment": "绅士之庭的签到模板，个人能力问题，仅域名为 **gmgard.com** 时可用。<br>该模板因为绅士之庭无法直接访问，故需要自行想办法解决网络问题。。"
  }
]
