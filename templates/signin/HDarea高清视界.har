[
  {
    "request": {
      "method": "POST",
      "url": "https://www.hdarea.co/sign_in.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "pragma",
          "value": "no-cache"
        },
        {
          "name": "cache-control",
          "value": "no-cache"
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "accept",
          "value": "*/*"
        },
        {
          "name": "origin",
          "value": "https://www.hdarea.co"
        },
        {
          "name": "referer",
          "value": "https://www.hdarea.co/index.php"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ],
      "data": "action=sign_in",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "请不要重复签到哦！",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "(.+)",
          "from": "content"
        }
      ]
    },
    "comment": "登录后首页cookie<br>https://www.hdarea.co/"
  }
]
