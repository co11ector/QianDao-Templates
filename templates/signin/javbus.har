[
  {
    "request": {
      "method": "GET",
      "url": "https://www.javbus.com/forum/home.php?mod=spacecp&ac=credit&op=base",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":authority",
          "value": "www.javbus.com"
        },
        {
          "name": ":method",
          "value": "GET"
        },
        {
          "name": ":path",
          "value": "/forum/home.php?mod=spacecp&ac=credit&op=base"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": "accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "cache-control",
          "value": "no-cache"
        },
        {
          "name": "pragma",
          "value": "no-cache"
        },
        {
          "name": "priority",
          "value": "u=0, i"
        },
        {
          "name": "referer",
          "value": "https://www.javbus.com/forum/home.php?mod=spacecp&ac=credit&op=base"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Google Chrome\";v=\"137\", \"Chromium\";v=\"137\", \"Not/A)Brand\";v=\"24\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "sec-fetch-dest",
          "value": "document"
        },
        {
          "name": "sec-fetch-mode",
          "value": "navigate"
        },
        {
          "name": "sec-fetch-site",
          "value": "same-origin"
        },
        {
          "name": "sec-fetch-user",
          "value": "?1"
        },
        {
          "name": "upgrade-insecure-requests",
          "value": "1"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "jq",
          "re": "金錢: </em>(\\d+)",
          "from": "content"
        },
        {
          "name": "lc",
          "re": "里程: </em>(\\d+)",
          "from": "content"
        },
        {
          "name": "__log__",
          "re": "金錢:{{jq}} | 里程:{{lc}}",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST\n",
      "url": "api://util/unicode?content=%20%E9%87%91%E9%8C%A2%3A%20{{jq|urlencode}}%20%7C%20%20%E9%87%8C%E7%A8%8B%3A{{lc|urlencode}}",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
