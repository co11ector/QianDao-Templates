[
  {
    "comment": "初始化变量",
    "request": {
      "method": "POST",
      "url": "api://util/string/replace",
      "headers": [],
      "data": "r=text&p=&s=1&t="
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "page",
          "re": ".*",
          "from": "content"
        },
        {
          "name": "pages",
          "re": ".*",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "http://tieba.baidu.com/f/user/json_userinfo?_=1407684256076",
