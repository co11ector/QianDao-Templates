[
  {
    "request": {
      "method": "GET",
      "url": "https://naiq.cc/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "Domain",
          "re": "href=\"(http.+?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "{{Domain}}/wp-admin/admin-ajax.php",
      "headers": [],
      "data": "username={{username}}&password={{password}}&remember=forever&action=user_signin"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\\\\u6210\\\\u529f\\\\u767b\\\\u5f55",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "{{Domain}}/wp-admin/admin-ajax.php",
      "headers": [],
      "data": "action=user_checkin"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "{{Domain}}/wp-admin/admin-ajax.php?action=checkin_details_modal",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "[\\s\\S]+",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content={{__log__ | striptags}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
