  {
    "comment": "",
    "request": {
      "method": "POST",
      "url": "https://blog.netsafety.club/wp-admin/admin-ajax.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "Accept-Language",
          "value": "en-US,en;q=0.9"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Host",
          "value": "blog.netsafety.club"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Google Chrome\";v=\"137\", \"Chromium\";v=\"137\", \"Not/A)Brand\";v=\"24\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-User",
          "value": "?1"
        },
        {
          "name": "Origin",
          "value": "https://blog.netsafety.club"
        },
        {
          "name": "Referer",
          "value": "https://blog.netsafety.club/"
        }
      ],
      "data": "action=xypro_choujiang&user_id={{userid}}&val=30&decs=%E8%AF%B7%E6%B1%82%E6%8A%BD%E5%A5%96&type=delete"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "lot_result",
          "re": "\"name\":\"([^\"]*)\"(?=,)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content={{lot_result}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "lot_result",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  },
