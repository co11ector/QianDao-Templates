[
  {
    "request": {
      "method": "GET",
      "url": "https://blog.netsafety.club/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "Accept-Language",
          "value": "en-US,en;q=0.9"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Host",
          "value": "blog.netsafety.club"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Google Chrome\";v=\"137\", \"Chromium\";v=\"137\", \"Not/A)Brand\";v=\"24\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "document"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "navigate"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "none"
        },
        {
          "name": "Sec-Fetch-User",
          "value": "?1"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "确认要退出当前登录吗",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    },
    "comment": "Cookie login<br>Signin Check<br>Lottery Pull if have ticket"
  },
