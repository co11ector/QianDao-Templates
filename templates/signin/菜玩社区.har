[
  {
    "request": {
      "method": "POST",
      "url": "https://caigamer.cn/my-sign.htm",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        {
          "name": "origin",
          "value": "https://caigamer.cn"
        },
        {
          "name": "referer",
          "value": "https://caigamer.cn/"
        },
        {
          "name": "x-requested-with",
          "value": "XMLHttpRequest"
        }
      ],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "请登录后再签到",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "msg",
          "re": "\"message\": \"(.+?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "",
    "request": {
      "method": "GET",
      "url": "https://caigamer.cn/my.htm",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "referer",
          "value": "https://caigamer.cn/"
        }
      ],
      "data": "action=check",
      "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "yhz",
          "re": "用户组：\\n.*\\n(.+)<br>",
          "from": "content"
        },
        {
          "name": "fl",
          "re": "肥料：<data>(.+)</data></p>",
          "from": "content"
        },
        {
          "name": "nl",
          "re": "能量</p>\\n(.+)",
          "from": "content"
        },
        {
          "name": "dq",
          "re": "点券</p>\\n(.+)",
          "from": "content"
        },
        {
          "name": "name",
          "re": "<meta property=\"og:title\" content=\"(.+)\">",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content=用户名：{{name}}\\r\\n 用户组：{{yhz}}，肥料：{{fl}} \\r\\n 能量：{{nl | striptags}}，点券：{{dq | striptags}} \\r\\n 签到结果：{{msg}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
