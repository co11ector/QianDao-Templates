[
  {
    "comment": "请求summoner_id",
    "request": {
      "method": "POST",
      "url": "https://www.op.gg/summoners/jp/{{id|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Sec-GPC",
          "value": "1"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.6"
        },
        {
          "name": "Origin",
          "value": "https://www.op.gg"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-site"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        }
      ],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "summoner_id",
          "re": "\"summoner_id\":\"(.+?)\",",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "https://op.gg/api/v1.0/internal/bypass/summoners/jp/{{summoner_id}}/renewal",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "op.gg"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Sec-GPC",
          "value": "1"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.6"
        },
        {
          "name": "Origin",
          "value": "https://www.op.gg"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-site"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Referer",
          "value": "https://www.op.gg/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        }
      ],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "Already renewed",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": ".*",
          "from": "content"
        }
      ]
    }
  }
]
