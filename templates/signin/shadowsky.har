[
  {
    "request": {
      "method": "POST",
      "url": "https://www.shadowsky.xyz/user/checkin",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "application/json, text/javascript, */*; q=0.01"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "DNT",
          "value": "1"
        },
        {
          "name": "Origin",
          "value": "https://www.shadowsky.xyz"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Referer",
          "value": "https://www.shadowsky.xyz/user"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Not/A)Brand\";v=\"99\", \"Microsoft Edge\";v=\"115\", \"Chromium\";v=\"115\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "302",
          "from": "status"
        }
      ],
      "extract_variables": [
        {
          "name": "log_value",
          "re": "{\\\"msg\\\":\\\"(.+?)\",",
          "from": "content"
        }
      ]
    },
    "comment": "cookie 签到领取流量奖励<br>https://www.shadowsky.xyz/"
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content=签到结果： {{log_value}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
