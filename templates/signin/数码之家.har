        {
          "re": "系统错误",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "re": "formhash=(.*?)\">",
          "from": "content",
          "name": "formhash"
        }
      ]
    },
    "comment": "首页cookie"
