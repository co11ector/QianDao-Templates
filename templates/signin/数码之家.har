  {
    "request": {
      "method": "GET",
      "url": "https://www.mydigit.cn/plugin.php?id=k_misign%3Asign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "www.mydigit.cn"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Referer",
          "value": "https://www.mydigit.cn/plugin.php?id=k_misign:sign"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "id=\"JD_sign\"",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "re": "id=\"lxreward\" value=\"(\\d+)\"",
          "from": "content",
          "name": "log_value"
        }
      ]
    }
  },
  {
    "comment": "生成日志",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=%C2%A0&p=%C2%A0&s=%E7%A7%AF%E5%88%86%3A%C2%A0%20{{log_value|urlencode}}",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": ".+",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
