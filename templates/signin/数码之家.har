          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Referer",
          "value": "https://www.mydigit.cn/home.php"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        }
      ],
      "data": "",
