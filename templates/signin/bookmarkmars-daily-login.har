[
  {
    "comment": "访问个人中心并确认登录，不领取奖励",
    "request": {
      "method": "GET",
      "url": "https://www.bookmarkmars.com/ucenter/info",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?=[\\s\\S]*href=[\"\\']/web/logout[\"\\'])[\\s\\S]*?id=[\"\\']about-info[\"\\'][^>]*>[\\s\\S]*?class=[\"\\']row basic-info[\"\\'][^>]*>\\s*<div[^>]*>\\s*用户名：\\s*[^\\s<][^<]*</div>",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "class=[\"\\']fun-title[\"\\'][^>]*>(?:[^<]|<[^>]+>)*?(基础信息)",
          "from": "content"
        }
      ]
    }
  }
]
