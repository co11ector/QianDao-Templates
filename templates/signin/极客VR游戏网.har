  {
    "request": {
      "method": "GET",
      "url": "https://www.179vr.cn/user/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "www.179vr.cn"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Cache-Control",
          "value": "max-age=0"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Not/A)Brand\";v=\"8\", \"Chromium\";v=\"126\", \"Microsoft Edge\";v=\"126\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "navigate"
        },
        {
          "name": "Sec-Fetch-User",
          "value": "?1"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "document"
        },
        {
          "name": "Referer",
          "value": "https://www.179vr.cn/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        }
      ],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "yy",
          "re": "<p>当前余额</p>[\\s]+<h3>([\\.\\d]+)</h3>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content={{ss}} | 水晶：{{yy}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
