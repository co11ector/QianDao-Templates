[
  {
    "request": {
      "method": "POST",
      "url": "https://www.179vr.cn/wp-admin/admin-ajax.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "www.179vr.cn"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Not/A)Brand\";v=\"8\", \"Chromium\";v=\"126\", \"Microsoft Edge\";v=\"126\""
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Origin",
          "value": "https://www.179vr.cn"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Referer",
          "value": "https://www.179vr.cn/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        }
      ],
      "data": "action=user_login&username={{user|urlencode}}&password={{pass|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    },
    "comment": "账号密码 日志显示"
