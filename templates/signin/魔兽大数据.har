[
  {
    "comment": "每日签到",
    "request": {
      "method": "POST",
      "url": "http://bj.wowdata.top/quest/doQuest/signin",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Accept",
          "value": "application/json, text/javascript, */*; q=0.01"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Origin",
          "value": "http://bj.wowdata.top"
        },
        {
          "name": "Referer",
          "value": "http://bj.wowdata.top/vip"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "\\u672a\\u767b\\u5f55",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "qdmsg",
          "re": "\"msg\":\"(.+?)\"",
          "from": "content"
        }
      ]
    }
  },
