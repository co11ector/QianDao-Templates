  {
    "comment": "每日世界频道发言",
    "request": {
      "method": "POST",
      "url": "http://bj.wowdata.top/chat/send",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Accept",
          "value": "application/json, text/javascript, */*; q=0.01"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Origin",
          "value": "http://bj.wowdata.top"
        },
        {
          "name": "Referer",
          "value": "http://bj.wowdata.top/vip"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ],
      "data": "topic=chat&message={{content|urlencode}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"code\":[^0]",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "白嫖页",
    "request": {
      "method": "GET",
      "url": "http://bj.wowdata.top/vip",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "Referer",
          "value": "http://bj.wowdata.top/vip"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "nq",
          "re": "怒气:(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "日志",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=%C2%A0&p=%C2%A0&s=%E6%AF%8F%E6%97%A5%E7%AD%BE%E5%88%B0%E6%83%85%E5%86%B5%EF%BC%9A%E3%80%90{{unicode(qdmsg|default(\"领取成功\"))|urlencode}}%E3%80%91%5Cr%5Cn%E6%AF%8F%E6%97%A5bilibili%E4%BB%BB%E5%8A%A1%E6%83%85%E5%86%B5%EF%BC%9A%E3%80%90{{unicode(biliMsg|default(\"领取成功\"))|urlencode}}%E3%80%91%5Cr%5Cn%E5%BD%93%E5%89%8D%E6%80%92%E6%B0%94%E5%80%BC%E4%B8%BA%EF%BC%9A%E3%80%90{{nq|urlencode}}%E3%80%91",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": ".+",
          "from": "content"
        }
      ]
    }
  }
]
