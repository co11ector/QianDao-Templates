[
  {
    "comment": "签到",
    "request": {
      "method": "POST",
      "url": "https://www.hifini.com/sg_sign.htm",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "pragma",
          "value": "no-cache"
        },
        {
          "name": "cache-control",
          "value": "no-cache"
        },
        {
          "name": "accept",
          "value": "text/plain, */*; q=0.01"
        },
        {
          "name": "x-requested-with",
          "value": "XMLHttpRequest"
        },
        {
          "name": "origin",
          "value": "https://www.hifini.com"
        },
        {
          "name": "referer",
          "value": "https://www.hifini.com/"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"message\": \"(.+?)\"",
          "from": "content"
        }
      ]
    }
  }
]
