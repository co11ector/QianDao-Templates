          "re": "您今天还没有签到",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "log_value",
          "re": "id=\"lxreward\" value=\"(.+?)\"",
          "from": "content"
        },
        {
          "name": "log_all",
          "re": "id=\"lxtdays\" value=\"(.+?)\"",
          "from": "content"
        },
        {
          "name": "log_days",
          "re": "id=\"lxdays\" value=\"(.+?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "生成日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [],
      "data": "content=累计已签到: {{log_all}} 天 , 本月已累计签到: {{log_days}} 天 , 获得的总奖励为:威望 {{log_value}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
