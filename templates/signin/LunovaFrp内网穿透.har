          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-US;q=0.7"
        },
        {
          "name": "Host",
          "value": "console.frp.api.xhuzim.top"
        },
        {
          "name": "Origin",
          "value": "https://console.xhfrp.xhuzim.top"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Referer",
          "value": "https://console.xhfrp.xhuzim.top/"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-site"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Microsoft Edge\";v=\"141\", \"Not?A_Brand\";v=\"8\", \"Chromium\";v=\"141\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"macOS\""
        },
        {
          "name": "Authorization",
          "value": "{{token}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "无效的Token",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
