[
  {
    "request": {
      "method": "POST",
      "url": "https://console.frp.api.xhuzim.top/api/v1/users/login",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-US;q=0.7"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Origin",
          "value": "https://console.xhfrp.xhuzim.top"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Referer",
          "value": "https://console.xhfrp.xhuzim.top/"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Microsoft Edge\";v=\"141\", \"Not?A_Brand\";v=\"8\", \"Chromium\";v=\"141\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"macOS\""
        }
      ],
      "data": "{\"account\":\"{{username}}\",\"password\":\"{{password}}\"}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "参数错误",
          "from": "content"
        },
        {
          "re": "密码错误",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "token",
          "re": "\"token\"\\s*:\\s*\"([^\"]+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "https://console.frp.api.xhuzim.top/api/v1/users/checkin/status",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
