[
  {
    "comment": "OCR识别不一定准确   把重试间隔调整60秒即可",
    "request": {
      "method": "GET",
      "url": "api://util/unicode?content=",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "https://www.qqvps.com/index/captcha",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "image/webp,image/png,image/svg+xml,image/*;q=0.8,video/*;q=0.8,*/*;q=0.5"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Referer",
          "value": "https://www.qqvps.com/logining"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Host",
          "value": "www.qqvps.com"
        },
        {
          "name": "Accept-Language",
          "value": "zh-cn"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "zz",
          "re": ".+",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "OCR识别",
    "request": {
      "method": "POST",
      "url": "api://util/dddd/ocr",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "data": "{\"img\":\"{{zz}}\",\"imgurl\":\"\",\"old\":\"False\"}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"OK\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "yzm",
          "re": "\"Result\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "https://www.qqvps.com/logining",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        {
          "name": "Origin",
          "value": "https://www.qqvps.com"
        },
        {
          "name": "Host",
          "value": "www.qqvps.com"
        },
        {
          "name": "Referer",
          "value": "https://www.qqvps.com/logining"
        },
        {
          "name": "Accept-Language",
          "value": "zh-cn"
        },
        {
          "name": "Accept",
          "value": "*/*"
        }
      ],
      "data": "email={{user|urlencode}}&pass={{pass|urlencode}}&code={{yzm|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "验证码错误",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "https://www.qqvps.com/user/sign_in/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":method",
          "value": "POST"
        },
        {
          "name": ":authority",
          "value": "www.qqvps.com"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": ":path",
          "value": "/user/sign_in/"
        },
        {
          "name": "pragma",
          "value": "no-cache"
        },
        {
          "name": "cache-control",
          "value": "no-cache"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Chromium\";v=\"21\", \" Not;A Brand\";v=\"99\""
        },
        {
          "name": "dnt",
          "value": "1"
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        {
          "name": "accept",
          "value": "application/json, text/javascript, */*; q=0.01"
        },
        {
          "name": "x-requested-with",
          "value": "XMLHttpRequest"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "origin",
          "value": "https://www.qqvps.com"
        },
        {
          "name": "sec-fetch-site",
          "value": "same-origin"
        },
        {
          "name": "sec-fetch-mode",
          "value": "cors"
        },
        {
          "name": "sec-fetch-dest",
          "value": "empty"
        },
        {
          "name": "referer",
          "value": "https://www.qqvps.com/user/index"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"msg\":\"(.+)\"",
          "from": "content"
        }
      ]
    }
  }
]
