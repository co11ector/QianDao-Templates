[
  {
    "comment": "",
    "request": {
      "method": "GET",
      "url": "https://{{domain}}/user",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "referer",
          "value": "https://{{domain}}/"
        }
      ],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "nonce",
          "re": "data-nonce=\"(.*?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "https://{{domain}}/wp-admin/admin-ajax.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "origin",
          "value": "https://{{domain}}"
        },
        {
          "name": "referer",
          "value": "https://{{domain}}/user"
        }
      ],
      "data": "action=user_qiandao&nonce={{nonce}}",
      "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\\\\u7b7e\\\\u5230\\\\u6210\\\\u529f",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\\\\u975e\\\\u6cd5\\\\u8bf7\\\\u6c42\\\\uff0c\\\\u8bf7\\\\u5237\\\\u65b0\\\\u91cd\\\\u8bd5",
          "from": "content"
        },
        {
          "re": "\\\\u8bf7\\\\u767b\\\\u5f55\\\\u540e\\\\u7b7e\\\\u5230",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "msg",
          "re": "\"msg\":\"(.*)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "",
    "request": {
      "method": "GET",
      "url": "https://{{domain}}/user",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "referer",
          "value": "https://{{domain}}/"
        }
      ],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "name",
          "re": "<span class=\"mx-display-name\">(.*?)<span",
          "from": "content"
        },
        {
          "name": "ye",
          "re": "当前余额：(.+)</p>",
          "from": "content"
        },
        {
          "name": "xf",
          "re": "累计消费：(.+)</p>",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "content=用户名：{{name}}\\r\\n 当前余额：{{ye}}，累计消费：{{xf}}\\r\\n 签到结果：{{msg}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
