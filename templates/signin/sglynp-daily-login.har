[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 www.sglynp.com 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】只读打开三宫六院首页和积分页，确认当前账号已登录；不会领取奖励、发帖、回复或修改账号设置。\n\n【成功判定】首页与积分页都必须出现退出登录链接，且不能出现登录表单、username 输入框或“请先登录”提示；仅 HTTP 200 不算成功。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 www.sglynp.com 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。",
    "request": {
      "method": "GET",
      "url": "https://www.sglynp.com/",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?:member|logging)\\.php\\?[^\"']*(?:mod=logging(?:&amp;|&)action=logout)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?:member|logging)\\.php\\?[^\"']*(?:mod=logging(?:&amp;|&)action=login)|name=[\"']username[\"']|id=[\"']lsform[\"']|用户登录页面|您需要先登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "只读访问积分页复核登录状态",
    "request": {
      "method": "GET",
      "url": "https://www.sglynp.com/home.php?mod=spacecp&ac=credit&showcredit=1",
      "headers": [
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://www.sglynp.com/"
        },
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "(?:member|logging)\\.php\\?[^\"']*(?:mod=logging(?:&amp;|&)action=logout)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "(?:member|logging)\\.php\\?[^\"']*(?:mod=logging(?:&amp;|&)action=login)|name=[\"']username[\"']|id=[\"']lsform[\"']|用户登录页面|您需要先登录|请先登录",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "生成执行日志",
    "request": {
      "method": "POST",
      "url": "api://util/urldecode",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "content=三宫六院登录状态已确认（仅访问公开页面）",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
