  {
    "comment": "返回对应时间戳和时间",
    "request": {
      "method": "POST",
      "url": "api://util/timestamp",
      "headers": [],
      "data": "ts=&form=&dt="
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "time",
          "re": "\"时间戳\":([^\"]+),",
          "from": "content"
        }
      ]
    }
  },
