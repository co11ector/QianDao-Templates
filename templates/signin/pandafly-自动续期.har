[
  {
    "request": {
      "method": "POST",
      "url": "https://pandafly.site/api/v1/passport/auth/login",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":authority",
          "value": "pandafly.site"
        },
        {
          "name": ":method",
          "value": "POST"
        },
        {
          "name": ":path",
          "value": "/api/v1/passport/auth/login"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": "accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br, zstd"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        },
        {
          "name": "content-language",
          "value": "zh-CN"
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "dnt",
          "value": "1"
        },
        {
          "name": "origin",
          "value": "https://pandafly.site"
        },
        {
          "name": "priority",
          "value": "u=1, i"
        },
        {
          "name": "referer",
          "value": "https://pandafly.site/"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Not A(Brand\";v=\"8\", \"Chromium\";v=\"132\", \"Microsoft Edge\";v=\"132\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"macOS\""
        },
        {
          "name": "sec-fetch-dest",
          "value": "empty"
        },
        {
          "name": "sec-fetch-mode",
          "value": "cors"
        },
        {
          "name": "sec-fetch-site",
          "value": "same-origin"
        }
      ],
      "data": "email={{ username |urlencode}}&password={{ password |urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "token",
          "re": "\"auth_data\":\"([^\"]+)\"",
          "from": "content"
        }
      ]
    },
    "comment": "自动创建续期订单"
  },
  {
