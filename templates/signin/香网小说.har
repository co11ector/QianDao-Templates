[
  {
    "request": {
      "method": "POST",
      "url": "http://m.xiang5.com/dosign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "\\\\u8bf7\\\\u767b\\\\u5f55",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "continue",
          "re": "\"continue\":(\\d+)",
          "from": "content"
        },
        {
          "name": "money",
          "re": "\"money\":(\\d+)",
          "from": "content"
        },
        {
          "name": "ticket",
          "re": "\"ticket\":(\\d+)",
          "from": "content"
        }
      ]
    },
    "comment": "登录后首页cookie<br>https://m.xiang5.com/"
  },
  {
    "comment": "生成日志",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=%C2%A0&p=%C2%A0&s=%E7%AD%BE%E5%88%B0%E6%88%90%E5%8A%9F!%E8%8E%B7%E5%BE%97{{money|urlencode}}%E9%A6%99%E8%B1%86%2C{{ticket|urlencode}}%E4%B9%A6%E5%88%B8%2C%E8%BF%9E%E7%AD%BE{{continue|urlencode}}%E5%A4%A9",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": ".+",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
]
