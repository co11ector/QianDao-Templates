[
  {
    "comment": "登陆",
    "request": {
      "method": "POST",
      "url": "https:///{{domain}}/api/front/login/leyifan",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "system",
          "value": "ios"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "platform",
          "value": "app"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "lang",
          "value": "chs"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "UseDomain",
          "value": "leyifan"
        }
      ],
      "data": "{\"password\":\"{{password}}\",\"account\":\"{{email}}\",\"version\":\"V2\"}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "用户或密码不正确",
          "from": "content"
        },
        {
          "re": "暂不支持此邮箱格式，请更换其他邮箱完成操作",
          "from": "content"
        },
        {
          "re": "检测到您为非大陆用户，由于区域政策及合规要求等多方面因素，目前大陆地区的商城暂时无法为非大陆用户提供服务。建议您使用港澳台地区的APP",
          "from": "content"
        },
        {
          "re": "港澳台的商城暂时无法为大陆用户提供服务",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "token",
          "re": "\"token\"\\s*:\\s*\"([^\"]+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "延时3秒",
    "request": {
      "method": "GET",
      "url": "api://util/delay/3",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ]
    }
  },
  {
    "comment": "请求签到",
    "request": {
      "method": "GET",
      "url": "https://{{domain}}/api/front/user/sign/integral",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "system",
          "value": "ios"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Authori-zation",
          "value": "{{token}}"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "platform",
          "value": "app"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "lang",
          "value": "chs"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "UseDomain",
          "value": "leyifan"
        }
      ],
      "data": "",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "",
    "request": {
      "method": "GET",
      "url": "https:///{{domain}}/api/front/integral/list?page=1&limit=10",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "system",
          "value": "ios"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Authori-zation",
          "value": "{{token}}"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "platform",
          "value": "app"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "lang",
          "value": "chs"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "UseDomain",
          "value": "leyifan"
        }
      ],
      "data": "",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "integral",
          "re": "\"integral\"\\s*:\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "延时3秒",
    "request": {
      "method": "GET",
      "url": "api://util/delay/3",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ]
    }
  },
  {
    "comment": "获取签到结果",
    "request": {
      "method": "POST",
      "url": "https:///{{domain}}/api/front/user/sign/user",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "system",
          "value": "ios"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Authori-zation",
          "value": "{{token}}"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "platform",
          "value": "app"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "lang",
          "value": "chs"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "UseDomain",
          "value": "leyifan"
        }
      ],
      "data": "{\"all\":0,\"integral\":0,\"sign\":1}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "signNum",
          "re": "\"signNum\"\\s*:\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "sumSignDay",
          "re": "\"sumSignDay\"\\s*:\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "integrals",
          "re": "\"integral\"\\s*:\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content=今天签到积分:{{integral}} 连续签到天数:{{signNum}} 累计签到天数:{{sumSignDay}} 总积分:{{integrals}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
