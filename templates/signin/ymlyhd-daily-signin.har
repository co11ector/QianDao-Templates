[
  {
    "comment": "读取签到页并确认登录态与动态 formhash",
    "request": {
      "method": "GET",
      "url": "https://www.ymlyhd.com/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
          {
            "re": "/(?=.*name=[\"']formhash[\"']\\s+value=[\"'][^\"']+)(?=.*(?:action=logout|退出))/is",
            "from": "content"
          }
      ],
      "failed_asserts": [
        {
            "re": "(您需要先登录|请先登录|登录后进行|member\\.php\\?mod=logging(?:&amp;|&)action=login|验证码|人机验证|安全检查|Just a moment|Cloudflare)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "formhash",
          "re": "name=\"formhash\" value=\"(.*?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交每日签到并要求明确业务结果",
    "request": {
      "method": "POST",
      "url": "https://www.ymlyhd.com/plugin.php?id=dsu_paulsign:sign&operation=qiandao&infloat=1",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Referer",
          "value": "https://www.ymlyhd.com/plugin.php?id=dsu_paulsign:sign"
        },
        {
          "name": "Origin",
          "value": "https://www.ymlyhd.com"
        }
      ],
      "cookies": [],
      "data": "formhash={{formhash|urlencode}}&qdxq=kx&qdmode=3&todaysay=",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
            "re": "/(?:签到成功|已经签到|今日已签到|已经签过|您今天已经签到过了)/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "(您需要先登录|请先登录|登录后进行|非法字符|未定义操作|验证码|人机验证|安全检查|Just a moment|Cloudflare)",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "复查登录态并确认今日签到成功",
    "request": {
      "method": "GET",
      "url": "https://www.ymlyhd.com/plugin.php?id=dsu_paulsign:sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
            "re": "/(?=.*(?:签到成功|已经签到|今日已签到|已经签过|您今天已经签到过了))(?=.*(?:action=logout|退出))/is",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
            "re": "(您需要先登录|请先登录|登录后进行|验证码|人机验证|安全检查|Just a moment|Cloudflare)",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "(签到成功|已经签到|今日已签到|已经签过|您今天已经签到过了)",
          "from": "content"
        }
      ]
    }
  }
]
