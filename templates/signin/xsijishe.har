          "value": "{{user_agent}}"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "balance",
          "re": "车票: </em>(\\d+)",
          "from": "content"
