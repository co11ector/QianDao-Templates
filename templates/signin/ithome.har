[
  {
    "comment": "IT之家 每日签到（App 接口 napi.ithome.com）。变量 userHash 填 cookie「jwtuser」的完整值，形如 Bearer%20eyJ…：在浏览器登录 www.ithome.com 后，用开发者工具或本项目的 Cookie 提取扩展复制该 cookie 即可（不要去掉 Bearer%20 前缀，也不要解码）。签到结果会写在任务日志里；重复执行只回复「今日已签到」，不会重复领金币。",
    "request": {
      "method": "GET",
      "url": "https://napi.ithome.com/api/usersign/sign?userHash={{userHash}}",
      "headers": [
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Accept-Language",
          "value": "zh-Hans-CN;q=1, en-US;q=0.9"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "User-Agent",
          "value": "ITHomeClient/9.32 (iPhone; iOS 18.3.2; Scale/3.00)"
        }
      ],
      "cookies": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"ok\":(0|1)",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "^(4|5)\\d\\d$",
          "from": "status"
        },
        {
          "re": "未登录|请先登录|登录已过期|凭证",
          "from": "content"
        }
      ]
    }
  }
]
