[
  {
    "request": {
      "method": "GET",
      "url": "https://totheglory.im/my.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":method",
          "value": "GET"
        },
        {
          "name": ":authority",
          "value": "totheglory.im"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": ":path",
          "value": "/my.php"
        },
        {
          "name": "pragma",
          "value": "no-cache"
        },
        {
          "name": "cache-control",
          "value": "no-cache"
        },
        {
          "name": "upgrade-insecure-requests",
          "value": "1"
        },
        {
          "name": "accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8"
        },
        {
          "name": "referer",
          "value": "https://totheglory.im/login.php"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "php\\?id=(.+?)\">",
          "from": "content",
          "name": "id"
        },
        {
          "re": "return false;\" title=\"(.+?)\">",
          "from": "content",
          "name": "log_jf"
        },
        {
          "re": "/mybonus.php\">(.+?)</a>",
          "from": "content",
          "name": "log_jf"
        },
        {
          "re": "下载量 :</font> <font color=black><a href=\"#\" onclick=\"return false;\" title=\".*?\">(.+?)</a>",
          "from": "content",
          "name": "log_xzl"
        },
        {
          "re": "上传量 : </font> <font color=black><a href=\"#\" onclick=\"return false;\" title=\".*?\">(.+?)</a>",
          "from": "content",
          "name": "log_scl"
        },
        {
          "re": "分享率 :</font>(.+?)<font",
          "from": "content",
          "name": "log_fxl"
        },
        {
          "re": "signed_token: \\\"(.*)\\\"",
          "from": "content",
          "name": "token"
        },
        {
          "re": "{signed_timestamp: \\\"(\\d+)\\\"",
          "from": "content",
          "name": "timestamp"
        }
      ]
    },
    "comment": "登录后首页cookie<br>https://totheglory.im/"
  },
  {
    "request": {
      "method": "POST",
      "url": "https://totheglory.im/signed.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "origin",
          "value": "https://totheglory.im"
        },
        {
          "name": "x-requested-with",
          "value": "XMLHttpRequest"
        },
        {
          "name": ":path",
          "value": "/signed.php"
        },
        {
          "name": "pragma",
          "value": "no-cache"
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "accept",
          "value": "*/*"
        },
        {
          "name": "cache-control",
          "value": "no-cache"
        },
        {
          "name": ":authority",
          "value": "totheglory.im"
        },
        {
          "name": "referer",
          "value": "https://totheglory.im/my.php"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": ":method",
          "value": "POST"
        }
      ],
      "data": "signed_timestamp={{timestamp|urlencode}}&signed_token={{token|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "https://totheglory.im/login.php",
          "from": "content"
        },
        {
          "re": "失败登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "re": "(.*)",
          "from": "content",
          "name": "info"
        }
      ]
    }
  },
  {
    "comment": "Copy_",
    "request": {
      "method": "POST",
      "url": "https://totheglory.im/userdetails.php?id={{id|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "origin",
          "value": "https://totheglory.im"
        },
        {
          "name": "x-requested-with",
          "value": "XMLHttpRequest"
        },
        {
          "name": ":path",
          "value": "/signed.php"
        },
        {
          "name": "pragma",
          "value": "no-cache"
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "accept",
          "value": "*/*"
        },
        {
          "name": "cache-control",
          "value": "no-cache"
        },
        {
          "name": ":authority",
          "value": "totheglory.im"
        },
        {
          "name": "referer",
          "value": "https://totheglory.im/my.php"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": ":method",
          "value": "POST"
        }
      ],
      "data": "?id={{id}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "https://totheglory.im/login.php",
          "from": "content"
        },
        {
          "re": "失败登录",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "re": "HP:&nbsp;</font>(\\d+)",
          "from": "content",
          "name": "log_hp"
        }
      ]
    }
  },
  {
    "comment": "unicode转换",
    "request": {
      "method": "GET",
      "url": "api://util/unicode?content=%E4%B8%8A%E4%BC%A0%E9%87%8F%3A%20{{log_scl|urlencode}}%20%7C%20%E4%B8%8B%E8%BD%BD%E9%87%8F%3A%20{{log_xzl|urlencode}}%20%7C%20%E5%88%86%E4%BA%AB%E7%8E%87%3A%20{{log_fxl|urlencode}}%C2%A0%C2%A0%7C%20HP%3A%20{{log_hp|urlencode}}%C2%A0%7C%20%E7%A7%AF%E5%88%86%3A%20{{log_jf|urlencode}}%20%7C%20%5Cr%5Cn%E7%AD%BE%E5%88%B0%3A%20{{info|urlencode}}",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
