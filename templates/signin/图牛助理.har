[
  {
    "request": {
      "method": "POST",
      "url": "http://tuniu2.ps6b.com/api/v1/member/login",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Access-Control-Allow-Headers",
          "value": "X-Requested-With,Content-Type"
        },
        {
          "name": "Access-Control-Allow-Methods",
          "value": "OPTIONS, GET, POST, DELETE"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Origin",
          "value": "file://"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        }
      ],
      "data": "mobile={{ username |urlencode}}&password={{ password |urlencode}}&group=photoshop",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "账号或者密码错误",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "access_token",
          "re": "\"access_token\":\"(.+?)\",\"expiration_time\"",
          "from": "content"
        }
      ]
    },
    "comment": "PS插件图牛助理签到积分"
  },
  {
    "request": {
      "method": "GET",
      "url": "http://tuniu2.ps6b.com/api/v1/member/sign-count",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{access_token}}"
        },
        {
          "name": "Access-Control-Allow-Headers",
          "value": "X-Requested-With,Content-Type"
        },
        {
          "name": "Access-Control-Allow-Methods",
          "value": "OPTIONS, GET, POST, DELETE"
        },
        {
          "name": "Origin",
          "value": "file://"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        }
      ],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "登录失败",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "http://tuniu2.ps6b.com/api/v1/member/sign-in",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept",
          "value": "application/json, text/plain, */*"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{access_token}}"
        },
        {
          "name": "Access-Control-Allow-Headers",
          "value": "X-Requested-With,Content-Type"
        },
        {
          "name": "Access-Control-Allow-Methods",
          "value": "OPTIONS, GET, POST, DELETE"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Origin",
          "value": "file://"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        }
      ],
      "data": "",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"message\":\"(.+)\",\"data\"",
          "from": "content"
        }
      ]
    }
  }
]
