  {
    "comment": "",
    "request": {
      "method": "GET",
      "url": "https://api.sfacg.com/user?expand=welfareCoin",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "api.sfacg.com"
        },
        {
          "name": "accept-charset",
          "value": "UTF-8"
        },
        {
          "name": "accept",
          "value": "application/vnd.sfacg.api+json;version=1"
        },
        {
          "name": "accept-encoding",
          "value": "gzip"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "nickName",
          "re": "\"nickName\":\"(.+?)\"",
          "from": "content"
        },
        {
          "name": "welfareCoin",
          "re": "\"welfareCoin\":(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "",
    "request": {
      "method": "GET",
      "url": "https://api.sfacg.com/user/money",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "api.sfacg.com"
        },
        {
          "name": "accept-charset",
          "value": "UTF-8"
        },
        {
          "name": "accept",
          "value": "application/vnd.sfacg.api+json;version=1"
        },
        {
          "name": "accept-encoding",
          "value": "gzip"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "fire_money_remain",
          "re": "\"fireMoneyRemain\":(\\d+)",
          "from": "content"
        },
        {
          "name": "vip_level",
          "re": "\"vipLevel\":(\\d+)",
          "from": "content"
        },
        {
          "name": "couponsRemain",
          "re": "\"couponsRemain\":(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "content=账号名称：{{nickName}}\\r\\n 火券：{{fire_money_remain}}，代券：{{couponsRemain}}\\r\\n VIP等级：{{vip_level}}，金币：{{welfareCoin}}\\r\\n 签到结果：本次签到获得 {{coupons}} 代券，您已连续签到 {{continusDay}} 天！"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
