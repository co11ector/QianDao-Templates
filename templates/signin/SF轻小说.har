[
  {
    "request": {
      "method": "PUT",
      "url": "https://api.sfacg.com/user/signInfo",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "api.sfacg.com"
        },
        {
          "name": "accept-charset",
          "value": "UTF-8"
        },
        {
          "name": "accept",
          "value": "application/vnd.sfacg.api+json;version=1"
        },
        {
          "name": "accept-encoding",
          "value": "gzip"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "您今天已经签过到了,请明天再来",
          "from": "content"
        },
        {
          "re": "409",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "401",
          "from": "status"
        },
        {
          "re": "400",
          "from": "status"
        },
        {
          "re": "没有访问接口的权限|需要登录才能访问该资源|签到系统在每日凌晨0~1点之间进行维护,请您选在其他时间签到哦",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "coupons",
          "re": "\"coupons\":(\\d+)",
          "from": "content"
        },
        {
          "name": "continusDay",
          "re": "\"continusDay\":(\\d+)",
          "from": "content"
        }
      ]
    },
    "comment": "每日签到和阅读时长任务, 需要在凌晨一点后执行<br>（网页或者APP均可，需要使用抓取 Cookie 时对应 UA，不可更改）<br>https://www.sfacg.com/"
  },
  {
    "comment": "返回当前时间戳和时间",
    "request": {
      "method": "GET",
      "url": "api://util/timestamp",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "now_time",
          "re": "\"本机时间\": \"(.+?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "",
    "request": {
      "method": "PUT",
      "url": "https://api.sfacg.com/user/readingtime",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "api.sfacg.com"
        },
        {
          "name": "accept-charset",
          "value": "UTF-8"
        },
        {
          "name": "accept",
          "value": "application/vnd.sfacg.api+json;version=1"
        },
        {
          "name": "accept-encoding",
          "value": "gzip"
        },
        {
          "name": "content-type",
          "value": "application/json; charset=UTF-8"
        }
      ],
      "data": "{\"seconds\": 7250, \"readingDate\": \"{{now_time}}\", \"entityType\": 2}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "提交的时间格式有误",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "",
