[
  {
    "request": {
      "method": "POST",
      "url": "http://ht.ys168.com/login.aspx",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/plain, */*; q=0.01"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        {
          "name": "DNT",
          "value": "1"
        },
        {
          "name": "Host",
          "value": "ht.ys168.com"
        },
        {
          "name": "Origin",
          "value": "http://ht.ys168.com"
        },
        {
          "name": "Proxy-Connection",
          "value": "keep-alive"
        },
        {
          "name": "Referer",
          "value": "http://ht.ys168.com/login.aspx"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        }
      ],
      "data": "cz=Dl&yhm={{username|urlencode}}&glmm={{password|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": ".+",
          "from": "content"
        }
      ]
    },
    "comment": "用户名密码登录，默认建议调整到每季度一次登录即可激活账号，官方要求每年至少一次登录<br>http://www.ys168.com/<br>作为国内老一代云盘选手，从网吧时代坚挺到现在，为老板点赞"
  }
]
