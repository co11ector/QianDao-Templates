[
  {
    "request": {
      "method": "POST",
      "url": "https://mult.utour.top/api/login",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "mult.utour.top"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Chromium\";v=\"21\", \" Not;A Brand\";v=\"99\""
        },
        {
          "name": "DNT",
          "value": "1"
        },
        {
          "name": "Form-type",
          "value": "h5"
        },
        {
          "name": "content-type",
          "value": "application/json"
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Origin",
          "value": "https://mult.utour.top"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Referer",
          "value": "https://mult.utour.top/pages/users/login/index"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "{\"account\":\"{{user}}\",\"password\":\"{{pass}}\"}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "token",
          "re": "token\":\"(.+)\",\"expir",
          "from": "content"
        }
      ]
    },
    "comment": "username:账号<br>password:密码<br>https://mult.utour.top/"
  },
  {
    "request": {
      "method": "POST",
      "url": "https://mult.utour.top/api/sign/integral",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "mult.utour.top"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "DNT",
          "value": "1"
        },
        {
          "name": "Authori-zation",
          "value": "Bearer {{token}}"
        },
        {
          "name": "Form-type",
          "value": "h5"
        },
        {
          "name": "content-type",
          "value": "application/json"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Origin",
          "value": "https://mult.utour.top"
        },
        {
          "name": "Sec-Fetch-Site",
          "value": "same-origin"
        },
        {
          "name": "Sec-Fetch-Mode",
          "value": "cors"
        },
        {
          "name": "Sec-Fetch-Dest",
          "value": "empty"
        },
        {
          "name": "Referer",
          "value": "https://mult.utour.top/pages/users/user_sgin/index"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        }
      ],
      "data": "{}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "jf",
          "re": "\"msg\":\"([^\"]+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
