  {
    "comment": "Unicode转换",
    "request": {
      "method": "GET",
      "url": "api://util/unicode?content={{jf|urlencode}}%5Cr%5Cn%E8%BF%9E%E7%BB%AD%E7%AD%BE%E5%88%B0%E5%A4%A9%E6%95%B0%3A{{ts|urlencode}}%20%7C%20%E7%A7%AF%E5%88%86%3A{{zjf|urlencode}}",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
