[
  {
    "request": {
      "method": "GET",
      "url": "https://www.hifiti.com/sg_sign.htm",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":method",
          "value": "GET"
        },
        {
          "name": ":authority",
          "value": "www.hifiti.com"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": ":path",
          "value": "/sg_sign.htm"
        },
        {
          "name": "upgrade-insecure-requests",
          "value": "1"
        },
        {
          "name": "dnt",
          "value": "1"
        },
        {
          "name": "accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "sec-fetch-site",
          "value": "same-origin"
        },
        {
          "name": "sec-fetch-mode",
          "value": "navigate"
        },
        {
          "name": "sec-fetch-user",
          "value": "?1"
        },
        {
          "name": "sec-fetch-dest",
          "value": "document"
        },
        {
          "name": "referer",
          "value": "https://www.hifiti.com/"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "sign",
          "re": "var sign = \"(.+)\"",
          "from": "content"
        }
      ]
    },
    "comment": "cookie | 日志输出"
  },
  {
    "request": {
      "method": "POST",
      "url": "https://www.hifiti.com/sg_sign.htm",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": ":authority",
          "value": "www.hifiti.com"
        },
        {
          "name": ":method",
          "value": "POST"
        },
        {
          "name": ":path",
          "value": "/sg_sign.htm"
        },
        {
          "name": ":scheme",
          "value": "https"
        },
        {
          "name": "accept",
          "value": "text/plain, */*; q=0.01"
        },
        {
          "name": "accept-encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "accept-language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "content-length",
          "value": "69"
        },
        {
          "name": "content-type",
          "value": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        {
          "name": "dnt",
          "value": "1"
        },
        {
          "name": "origin",
          "value": "https://www.hifiti.com"
        },
        {
          "name": "referer",
          "value": "https://www.hifiti.com/"
        },
        {
          "name": "sec-ch-ua",
          "value": "\"Chromium\";v=\"119\", \"Not?A_Brand\";v=\"24\""
        },
        {
          "name": "sec-ch-ua-mobile",
          "value": "?0"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "sec-fetch-dest",
          "value": "empty"
        },
        {
          "name": "sec-fetch-mode",
          "value": "cors"
        },
        {
          "name": "sec-fetch-site",
          "value": "same-origin"
        },
        {
          "name": "x-requested-with",
          "value": "XMLHttpRequest"
        }
      ],
      "data": "sign={{sign|urlencode}}",
      "mimeType": "application/x-www-form-urlencoded; charset=UTF-8"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"message\": \"(.+)\"",
          "from": "content"
        }
      ]
    }
  }
]
