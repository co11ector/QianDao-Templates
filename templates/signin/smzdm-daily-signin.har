[
  {
    "comment": "使用 Cookie 与同一浏览器 User-Agent 调用什么值得买每日签到接口；只执行固定签到，不进入其它额外奖励、评论或关注流程",
    "request": {
      "method": "POST",
      "url": "https://user-api.smzdm.com/checkin",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "application/json,text/plain,*/*"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        }
      ],
      "cookies": [],
      "data": "weixin=1&basic_v=0&f=android&v=10.4.26&{% set ts = (timestamp()|int * 1000) %}time={{ts}}&sign={{(\"basic_v=0&f=android&time=\" ~ (ts|string) ~ \"&v=10.4.26&weixin=1&key=apr1$AwP!wRRT$gJ/q.X24poeBInlUJC\")|md5|upper}}",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?0\"?",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"error_code\"\\s*:\\s*\"?(?!0\"?(?:[,}]))\\d+\"?",
          "from": "content"
        },
        {
          "re": "请登录|登录失效|未登录|身份验证失败|验证码|安全验证|Geetest|图片验证码",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "daily_num",
          "re": "\"daily_num\"\\s*:\\s*\"?(\\d+)",
          "from": "content"
        },
        {
          "name": "cgold",
          "re": "\"cgold\"\\s*:\\s*\"?(-?\\d+)",
          "from": "content"
        },
        {
          "name": "pre_re_silver",
          "re": "\"pre_re_silver\"\\s*:\\s*\"?(-?\\d+)",
          "from": "content"
        },
        {
          "name": "checkin_msg",
          "re": "\"error_msg\"\\s*:\\s*\"([^\"]+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "输出什么值得买签到结果",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "msg=什么值得买签到完成 - {{checkin_msg|default('签到成功')}} - 连续签到:{{daily_num|default('0')}} 天 - 金币:{{cgold|default('0')}} - 银元:{{pre_re_silver|default('0')}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "\"状态\"\\s*:\\s*\"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\"\\s*:\\s*\"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
