[
  {
    "comment": "登录状态验证",
    "request": {
      "method": "GET",
      "url": "https://n.cg.163.com/api/v2/users/@me",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Authorization",
          "value": " {{Authorization}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept",
          "value": "*/*"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "签到",
    "request": {
      "method": "POST",
      "url": "https://n.cg.163.com/api/v2/sign-today",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Authorization",
          "value": "{{Authorization}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  }
]
