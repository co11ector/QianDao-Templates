[
  {
    "request": {
      "method": "GET",
      "url": "https://bbs.meizu.cn/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "bbs.meizu.cn"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Cache-Control",
          "value": "max-age=0"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, sdch, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.8"
        },
        {
          "name": "If-None-Match",
          "value": "W/\"5aa56ea1-1b3ca\""
        },
        {
          "name": "If-Modified-Since",
          "value": "Sun, 11 Mar 2018 18:00:01 GMT"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "name=\"formhash\" value=\"(.+)\"",
          "from": "content",
          "name": "formhash"
        }
      ]
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "https://bbs.meizu.cn/app.php?mod=signin&action=sign&formhash={{formhash|urlencode|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "bbs.meizu.cn"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Content-Length",
          "value": "0"
        },
        {
          "name": "Accept",
          "value": "application/json, text/javascript, */*; q=0.01"
        },
        {
          "name": "Origin",
          "value": "https://bbs.meizu.cn"
        },
        {
          "name": "X-Requested-With",
          "value": "XMLHttpRequest"
        },
        {
          "name": "Referer",
          "value": "https://bbs.meizu.cn/"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.8"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": "\"message\":\"(.+)\"}",
          "from": "content",
          "name": "res"
        }
      ]
    }
  },
  {
    "comment": "生成日志",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=%C2%A0&p=%C2%A0&s=%E7%AD%BE%E5%88%B0%E7%8A%B6%E6%80%81%3A%20{{unicode(res)|urlencode}}%C2%A0",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "re": ".+",
          "from": "content",
          "name": "__log__"
        }
      ]
    }
  }
]
