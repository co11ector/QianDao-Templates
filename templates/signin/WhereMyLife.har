[
  {
    "comment": "登录",
    "request": {
      "method": "POST",
      "url": "https://wheremylife.cn/1.0/user/login",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "sec-ch-ua-platform",
          "value": "\"Windows\""
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Origin",
          "value": "https://wheremylife.cn"
        },
        {
          "name": "Referer",
          "value": "https://wheremylife.cn/home"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ],
      "data": "{\"email\":\"{{username}}\",\"password\":\"{{password}}\"}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [
        {
          "re": "\"isSucceed\":false",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "签到",
    "request": {
      "method": "POST",
      "url": "https://wheremylife.cn/1.0/user/resetBook",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Origin",
          "value": "https://wheremylife.cn"
        },
        {
          "name": "Referer",
          "value": "https://wheremylife.cn/home"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ],
      "data": "{}",
      "mimeType": "application/json"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "msg",
          "re": "\"message\":\"(.+?)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "获取剩余推送次数",
    "request": {
      "method": "GET",
      "url": "https://wheremylife.cn/1.0/user/book",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Accept",
          "value": "*/*"
        },
        {
          "name": "Referer",
          "value": "https://wheremylife.cn/home"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate, br"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ]
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "count",
          "re": "\"count\":(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "日志",
    "request": {
      "method": "GET",
      "url": "api://util/string/replace?r=text&t=%C2%A0&p=%C2%A0&s=%E7%AD%BE%E5%88%B0%E4%BF%A1%E6%81%AF%EF%BC%9A%E3%80%90{{msg|urlencode}}%E3%80%91%5Cr%5Cn%E5%89%A9%E4%BD%99%E6%8E%A8%E9%80%81%E6%AC%A1%E6%95%B0%EF%BC%9A%E3%80%90{{count|urlencode}}%E3%80%91",
      "headers": []
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": ".+",
          "from": "content"
        }
      ]
    }
  }
]
