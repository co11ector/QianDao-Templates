[
  {
    "request": {
      "method": "POST",
      "url": "http://www.doki8.com/wp-login.php",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Host",
          "value": "www.doki8.com"
        },
        {
          "name": "Connection",
          "value": "keep-alive"
        },
        {
          "name": "Pragma",
          "value": "no-cache"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        },
        {
          "name": "Upgrade-Insecure-Requests",
          "value": "1"
        },
        {
          "name": "Origin",
          "value": "http://www.doki8.com"
        },
        {
          "name": "Content-Type",
          "value": "application/x-www-form-urlencoded"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9"
        },
        {
          "name": "Referer",
          "value": "http://www.doki8.com/wp-login.php?redirect_to=http%3A%2F%2Fwww.doki8.com%2Ftourist"
        },
        {
          "name": "Accept-Encoding",
          "value": "gzip, deflate"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9,en;q=0.8"
        }
      ],
      "data": "log={{user}}&pwd={{passwd}}&wp-submit=%E7%99%BB%E5%BD%95&redirect_to=http%3A%2F%2Fwww.doki8.com%2Ftourist&testcookie=1",
      "mimeType": "application/x-www-form-urlencoded"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "302",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "GET",
      "url": "http://www.doki8.com/members/{{user}}/profile/edit/group/1/",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "mycred-mycred_default\">(.*?)</div>",
          "from": "content"
        }
      ]
    }
  }
]
