[
  {
    "request": {
      "method": "POST",
      "url": "https://www.vrmoo.net/wp-json/jwt-auth/v1/token",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        }
      ],
      "data": "username={{Email}}&password={{password}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "token",
          "re": "token\":\"(.+?)\"",
          "from": "content"
        },
        {
          "name": "user",
          "re": "name\":\"(.+?)\"",
          "from": "content"
        },
        {
          "name": "uid",
          "re": "id\":\"(\\d+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "For 循环开始",
    "request": {
      "method": "GET",
      "url": "{% for value in range(0, 3, 1) %}     ",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "request": {
      "method": "POST",
      "url": "https://www.vrmoo.net/wp-json/b2/v1/userMission",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{token}}"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "延时3秒",
    "request": {
      "method": "GET",
      "url": "api://util/delay/3",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": []
    }
  },
  {
    "comment": "",
    "request": {
      "method": "POST",
      "url": "https://www.vrmoo.net/wp-json/b2/v1/getUserMission",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{token}}"
        }
      ],
      "data": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "sj",
          "re": "date\":\"(.+?)\"",
          "from": "content"
        },
        {
          "name": "jf",
          "re": "credit\":\"(\\d+)\"",
          "from": "content"
        },
        {
          "name": "zjf",
          "re": "my_credit\":\"(\\d+)\"",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "For 循环结束",
    "request": {
      "method": "GET",
      "url": "{% endfor %}",
      "headers": [],
      "data": ""
    },
    "rule": {
      "success_asserts": []
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content=用户名：{{user}} 用户ID：{{uid}} 签到时间：{{sj}} 当日签到获得积分：{{jf}} 总积分：{{zjf}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
