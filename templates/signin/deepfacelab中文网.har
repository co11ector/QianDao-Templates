  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "data": "html_unescape=false&content=总灵石:{{ls}}"
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
