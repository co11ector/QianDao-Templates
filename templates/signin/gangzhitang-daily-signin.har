[
  {
    "comment": "使用登录后的完整 Cookie 与同一浏览器的 User-Agent 打开港知堂签到页，读取站点签到链接。登录失效、验证码或风控页面会失败关闭。",
    "request": {
      "method": "GET",
      "url": "https://gztown.org/plugin.php?id=zqlj_sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*id=zqlj_sign(?:&amp;|&)sign=[^\"'&]+)/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "sign",
          "re": "id=zqlj_sign(?:&amp;|&)sign=([^\"'&]+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交站点自身生成的签到链接；重复签到也视为成功",
    "request": {
      "method": "GET",
      "url": "https://gztown.org/plugin.php?id=zqlj_sign&sign={{sign|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://gztown.org/plugin.php?id=zqlj_sign"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "打卡成功|签到成功|您今天已经打过卡了|请勿重复操作",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "读取积分与等级",
    "request": {
      "method": "GET",
      "url": "https://gztown.org/home.php?mod=spacecp&ac=credit",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "积分|金钱|威望|银子",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "yz",
          "re": "银子:\\s*</em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "nl",
          "re": "内力:\\s*</em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "ww",
          "re": "威望:\\s*</em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "jf",
          "re": "积分:\\s*</em>\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "html_unescape=false&content=银子:{{yz}} 内力:{{nl}} 威望:{{ww}} 积分:{{jf}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
