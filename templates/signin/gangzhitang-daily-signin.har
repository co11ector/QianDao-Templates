[
  {
    "comment": "【认证方式】Cookie 登录态，不需要账号密码。使用登录 gztown.org 后的完整 Cookie 与同一浏览器 User-Agent，两项必须成对；推荐在已登录浏览器中用「QianDao Cookie Extractor」一键读取，手动复制时保留 Cookie 原文，不要解码或裁剪。\n\n【本模板做什么】打开港知堂固定签到页，读取站点自身生成的 zqlj_sign 签到链接并提交一次；重复打卡视为已完成。随后读取积分页的银子、内力、威望和总积分写入日志。不会发帖或操作其他插件。\n\n【成功判定】首次页面必须为已登录并提取到签到链接；提交回执必须是打卡成功、签到成功或今天已经打过卡，最终积分页还必须能读到账号积分摘要。\n\n【失效处理】站点返回登录页、明确提示登录失效、验证码或安全验证，以及页面结构不再符合预期时，任务会失败关闭，不会伪造成功。重新登录 gztown.org 后成对获取 Cookie 与 User-Agent 即可，模板本身不需要修改。\n\n【补充说明】登录失效、验证码、滑块、安全验证或异常请求都会失败关闭。",
    "request": {
      "method": "GET",
      "url": "https://gztown.org/plugin.php?id=zqlj_sign",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "/(?=[\\s\\S]*(?:action=logout|discuz_uid\\s*=\\s*[\"'][1-9]\\d*[\"']))(?=[\\s\\S]*id=zqlj_sign(?:&amp;|&)sign=[^\"'&]+)/i",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "sign",
          "re": "id=zqlj_sign(?:&amp;|&)sign=([^\"'&]+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "提交站点自身生成的签到链接；重复签到也视为成功",
    "request": {
      "method": "GET",
      "url": "https://gztown.org/plugin.php?id=zqlj_sign&sign={{sign|urlencode}}",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Referer",
          "value": "https://gztown.org/plugin.php?id=zqlj_sign"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "打卡成功|签到成功|您今天已经打过卡了|请勿重复操作",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        }
      ],
      "extract_variables": []
    }
  },
  {
    "comment": "读取积分与等级",
    "request": {
      "method": "GET",
      "url": "https://gztown.org/home.php?mod=spacecp&ac=credit",
      "headers": [
        {
          "name": "Cookie",
          "value": "{{cookie}}"
        },
        {
          "name": "User-Agent",
          "value": "{{user_agent}}"
        },
        {
          "name": "Accept",
          "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        },
        {
          "name": "Accept-Language",
          "value": "zh-CN,zh;q=0.9"
        },
        {
          "name": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "cookies": [],
      "data": "",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "积分|金钱|威望|银子",
          "from": "content"
        }
      ],
      "failed_asserts": [
        {
          "re": "member\\.php\\?mod=logging(?:&amp;|&)action=login|您需要先登录|请先登录|验证码|captcha|滑块|安全验证|异常请求",
          "from": "content"
        }
      ],
      "extract_variables": [
        {
          "name": "yz",
          "re": "银子:\\s*</em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "nl",
          "re": "内力:\\s*</em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "ww",
          "re": "威望:\\s*</em>\\s*(\\d+)",
          "from": "content"
        },
        {
          "name": "jf",
          "re": "积分:\\s*</em>\\s*(\\d+)",
          "from": "content"
        }
      ]
    }
  },
  {
    "comment": "Unicode转换",
    "request": {
      "method": "POST",
      "url": "api://util/unicode",
      "headers": [],
      "cookies": [],
      "data": "html_unescape=false&content=银子:{{yz}} 内力:{{nl}} 威望:{{ww}} 积分:{{jf}}",
      "mimeType": ""
    },
    "rule": {
      "success_asserts": [
        {
          "re": "200",
          "from": "status"
        },
        {
          "re": "\"状态\": \"200\"",
          "from": "content"
        }
      ],
      "failed_asserts": [],
      "extract_variables": [
        {
          "name": "__log__",
          "re": "\"转换后\": \"(.*)\"",
          "from": "content"
        }
      ]
    }
  }
]
